# Public site URL (canonical links, sitemap, Open Graph, allowed domains).
# Needed at build time. Example: https://example.com
SITE_URL=http://localhost:4321

# Contact delivery modes:
# console - logs message in terminal
# resend  - sends email using Resend
CONTACT_DELIVERY_MODE=console

# Resend email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
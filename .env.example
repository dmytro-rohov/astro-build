# Public site URL (canonical links, sitemap, Open Graph, allowed domains).
# Needed at build time. Example: https://example.com
SITE_URL=http://localhost:4321

# Google Analytics 4 Measurement ID (G-…). Leave empty to disable analytics
# and the cookie banner.
PUBLIC_GA_MEASUREMENT_ID=

# Contact delivery modes:
# console - logs message in terminal (default in development only)
# resend  - sends email using Resend
# In production this must be set, otherwise the form returns an error.
CONTACT_DELIVERY_MODE=console

# Resend email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
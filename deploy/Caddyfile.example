# Example Caddy config for a site built in contact.mode "remote" (static files only).
# Mirrors the headers and caching of server.mjs. Replace the domain and root.
#
#   npm run site:build -- --site /path/to/client-site --out /srv/sites/example
#
example.com, www.example.com {
	root * /srv/sites/example
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Hashed file names: cache for a year.
	@immutable path /_astro/* /fonts/* /icons/sprite.*.svg
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@brand path /favicon.ico /favicon.svg /site.webmanifest /icons/*.png /og-cover.jpg
	header @brand Cache-Control "public, max-age=86400"

	# One URL form: /contact/ → /contact
	@trailing path_regexp trailing ^(.+)/$
	redir @trailing {re.trailing.1} 301

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

# contact.mode "local" (Node server in Docker, see compose.yaml) instead:
#
# example.com {
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:4322 {
# 		# The contact rate limit trusts the first X-Forwarded-For entry:
# 		# Caddy overwrites it with the real client address.
# 		header_up X-Forwarded-For {remote_host}
# 	}
# }

---
import { ANALYTICS_CONFIG } from "@/config/analytics";
---

<aside
  class="cookie-consent"
  data-cookie-consent
  data-consent-version={ANALYTICS_CONFIG.consentVersion}
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
  hidden
>
  <div class="cookie-consent__content">
    <div class="cookie-consent__text">
      <p
        id="cookie-consent-title"
        class="cookie-consent__title"
      >
        Optional analytics
      </p>

      <p
        id="cookie-consent-description"
        class="cookie-consent__description"
      >
        We use optional Google Analytics cookies to understand how visitors use this portfolio. Analytics stays disabled unless        you accept it.
      </p>

      <a
        class="cookie-consent__privacy-link"
        href="/privacy"
      >
        Privacy policy
      </a>
    </div>

    <div class="cookie-consent__actions">
      <button
        class="cookie-consent__button cookie-consent__button--secondary"
        type="button"
        data-consent-reject
      >
        Reject
      </button>

      <button
        class="cookie-consent__button cookie-consent__button--primary"
        type="button"
        data-consent-accept
      >
        Accept analytics
      </button>
    </div>
  </div>
</aside>

<script>
  import {
    getAnalyticsConsent,
    loadGoogleAnalytics,
    setAnalyticsConsent,
  } from "@scripts/analytics-consent";

  const banner =
    document.querySelector<HTMLElement>("[data-cookie-consent]");

  const acceptButton =
    banner?.querySelector<HTMLButtonElement>("[data-consent-accept]");

  const rejectButton =
    banner?.querySelector<HTMLButtonElement>("[data-consent-reject]");

  function setButtonsDisabled(disabled: boolean): void {
    if (acceptButton) {
      acceptButton.disabled = disabled;
    }

    if (rejectButton) {
      rejectButton.disabled = disabled;
    }
}
  function showBanner(): void {
    if (!banner) {
      return;
    }

    setButtonsDisabled(false);
    banner.hidden = false;
    acceptButton?.focus();
  }

  function hideBanner(): void {
    if (!banner) {
      return;
    }

    banner.hidden = true;
  }

  async function initializeConsent(): Promise<void> {
    const storedConsent = getAnalyticsConsent();

    if (storedConsent === "granted") {
      try {
        await loadGoogleAnalytics();
      } catch (error) {
        console.error("Could not initialize analytics:", error);
      }

      hideBanner();
      return;
    }

    if (storedConsent === "denied") {
      hideBanner();
      return;
    }

    showBanner();
  }

  acceptButton?.addEventListener("click", async () => {
    setButtonsDisabled(true);

    try {
      await setAnalyticsConsent("granted");
      hideBanner();
    } catch (error) {
      console.error("Could not enable analytics:", error);
    } finally {
      setButtonsDisabled(false);
    }
  });

  rejectButton?.addEventListener("click", async () => {
    setButtonsDisabled(true);

    const analyticsWasLoaded = Boolean(
      document.querySelector(
        'script[data-ga-measurement-id]',
      ),
    );

    try {
      await setAnalyticsConsent("denied");

      if (analyticsWasLoaded) {
        window.location.reload();
        return;
      }

      hideBanner();
    } catch (error) {
      console.error("Could not disable analytics:", error);
      setButtonsDisabled(false);
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const settingsButton = target.closest("[data-cookie-settings]");

    if (!settingsButton) {
      return;
    }

    showBanner();
  });

  void initializeConsent();
</script>

<style lang="scss">

@use "sass:math";
@use "@styles/abstracts/functions" as *;
@use "@styles/abstracts/mixins" as *;

  .cookie-consent {
    position: fixed;
    z-index: 1000;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    justify-self: flex-end;
    left: clamp(1rem, 3vw, 2rem);
    max-width: 46rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid currentColor;
    background: var(--color-background-dark-pink, #17040c);
    color: var(--color-text-primary, #fff);
    box-shadow: var(--shadow-exist);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cookie-consent__title {
    margin: 0 0 1rem;
    font-size: 2rem;
    font-weight: 600;
  }

  .cookie-consent__description {
    max-width: 60ch;
    margin: 0;
    line-height: 1.6;
  }

  .cookie-consent__privacy-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cookie-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cookie-consent__button {
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid currentColor;
    font: inherit;
    cursor: pointer;
  }

  .cookie-consent__button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .cookie-consent__button--primary {
    background: var(--color-text-primary, #fff);
    color: var(--color-background-primary, #17040c);
  }

  .cookie-consent__button--secondary {
    background: transparent;
    color: inherit;
  }

  @include mq(sm) {
    .cookie-consent__title {
      font-size: 1.5rem;
      margin-bottom: .5rem;
    }
    .cookie-consent__button {
      padding: .4rem .5rem ;
      font-size: .8rem;
    }
    .cookie-consent__description,
    .cookie-consent__privacy-link {
      font-size: .8rem;
    }
  }
</style>
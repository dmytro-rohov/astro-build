---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Split from "@/components/layouts/Split.astro";
import Stack from "@/components/layouts/Stack.astro";
import Cluster from "@/components/layouts/Cluster.astro";

import Tag from "@/components/ui/Tag.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Img from "@/components/media/Img.astro";

export interface Props {
  /** Section id, used as an anchor (e.g. /#features). */
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;

  primaryAction?: {
    label: string;
    href?: string;
  };

  secondaryAction?: {
    label: string;
    href: string;
  };

  /** Local image (import from src/assets). Shown at 4:3 next to the text. */
  image?: ImageMetadata;
  /** Focal point kept visible when the image is cropped to 4:3. */
  imageFocal?: { x: number; y: number };
  imageAlt?: string;

  align?: "left" | "center";
  tone?: "default" | "muted" | "inverse" | "accent";
  /** Heading level of the section title: h1 for the first section of a page. */
  headingLevel?: "h1" | "h2";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryAction,
  secondaryAction,
  image,
  imageAlt = "",
  imageFocal,
  align = "left",
  tone = "default",
  headingLevel = "h1",
  class: className,
  ...restProps
} = Astro.props;

const Heading = headingLevel;

const hasImage = Boolean(image);
const hasActions = Boolean(primaryAction || secondaryAction);

// With an image the content sits next to the media; without one it is a single column.
const Layout = hasImage ? Split : Stack;
const layoutProps = hasImage
  ? { ratio: "text-media", gap: "2xl", align: "center" } as const
  : { space: "lg" } as const;
---

<Section
  {...restProps}
  spacing="xl"
  tone={tone}
  class:list={[
    "hero",
    `hero--align-${align}`,
    `hero--tone-${tone}`,
    hasImage && "hero--with-media",
    className,
  ]}
>
  <Container size="xl">
    <Layout {...layoutProps}>
      <Stack class="hero__content" space="lg">
        {eyebrow && (
          <Tag variant="primary" class="hero__eyebrow">
            {eyebrow}
          </Tag>
        )}

        <Stack space="md">
          <Heading class="hero__title">{title}</Heading>

          {description && (
            <p class="hero__description">
              {description}
            </p>
          )}
        </Stack>

        {hasActions && (
          <Cluster class="hero__actions" gap="md">
            {primaryAction && (
              <Button href={primaryAction.href} size="lg">
                {primaryAction.label}
              </Button>
            )}

            {secondaryAction && (
              <Link href={secondaryAction.href}>
                {secondaryAction.label}
              </Link>
            )}
          </Cluster>
        )}
      </Stack>

      {hasImage && (
        <div class="hero__media">
          <Img
            src={image}
            alt={imageAlt}
            kind={imageAlt ? "content" : "decorative"}
            priority="high"
            sizes="(min-width: 768px) 50vw, 100vw"
            widths={[480, 720, 960]}
            aspect={[4, 3]}
            focal={imageFocal}
            class="hero__image image--rounded image--shadow"
          />
        </div>
      )}
    </Layout>
  </Container>
</Section>

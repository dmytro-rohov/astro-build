---
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import { t } from "@/i18n";

export type NavItem = {
  label: string;
  href: string;
  external?: boolean;
};

export type NavAction = {
  label: string;
  href: string;
  external?: boolean;
};

export interface Props {
  items: NavItem[];
  cta?: NavAction;
  label?: string;
  class?: string;
}

const {
  items,
  cta,
  label = t.nav.label,
  class: className,
  ...restProps
} = Astro.props;

const currentPath = Astro.url.pathname;

function normalizePath(path: string) {
  if (path === "/") return "/";

  return path.replace(/\/$/, "");
}

function isActiveLink(href: string) {
  if (href.startsWith("http")) return false;
  if (href.startsWith("#")) return false;
  // Section links (/#features) point inside a page, not to the current page itself.
  if (href.includes("#")) return false;

  return normalizePath(href) === normalizePath(currentPath);
}
---

<nav
  {...restProps}
  class:list={[
    "navbar",
    className,
  ]}
  aria-label={label}
  data-navbar
>
  <button
    class="navbar__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="navbar-menu"
    data-navbar-toggle
  >
    <span class="navbar__toggle-text">{t.nav.menu}</span>
    <span class="navbar__icon" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div class="navbar__menu" id="navbar-menu" data-navbar-menu>
    <ul class="navbar__list">
      {items.map((item) => (
        <li class="navbar__item">
          <Link
            href={item.href}
            external={item.external}
            variant="nav"
            class="navbar__link"
            aria-current={isActiveLink(item.href) ? "page" : undefined}
          >
            {item.label}
          </Link>
        </li>
      ))}
    </ul>

    {cta && (
      <Button
        href={cta.href}
        external={cta.external}
        size="sm"
        class="navbar__cta"
      >
        {cta.label}
      </Button>
    )}
  </div>
</nav>

<script>
  const navbars = document.querySelectorAll("[data-navbar]");

  navbars.forEach((navbar) => {
    const toggle = navbar.querySelector("[data-navbar-toggle]");
    const menu = navbar.querySelector("[data-navbar-menu]");

    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) {
      return;
    }

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const closeMenu = ({ returnFocus = false } = {}) => {
      if (!isOpen()) {
        return;
      }

      toggle.setAttribute("aria-expanded", "false");
      navbar.removeAttribute("data-open");

      if (returnFocus) {
        toggle.focus();
      }
    };

    const openMenu = () => {
      toggle.setAttribute("aria-expanded", "true");
      navbar.setAttribute("data-open", "");
    };

    toggle.addEventListener("click", () => {
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        closeMenu();
      }
    });

    // Escape closes the menu and returns focus to the toggle,
    // so focus never stays on a link that is no longer visible.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        closeMenu({ returnFocus: menu.contains(document.activeElement) });
      }
    });

    // Clicking or tabbing outside the navigation closes the menu.
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !navbar.contains(event.target)) {
        closeMenu();
      }
    });

    navbar.addEventListener("focusout", (event) => {
      const next = (event as FocusEvent).relatedTarget;

      if (next instanceof Node && !navbar.contains(next)) {
        closeMenu();
      }
    });
  });
</script>

---
export type AccordionItem = {
  title: string;
  content: string;
  open?: boolean;
};

export interface Props {
  items: AccordionItem[];
  variant?: "default" | "boxed" | "minimal";
  class?: string;
}

const {
  items,
  variant = "default",
  class: className,
  ...restProps
} = Astro.props;
---

<div
  {...restProps}
  class:list={[
    "accordion",
    `accordion--${variant}`,
    className,
  ]}
>
  {items.map((item) => (
    <details class="accordion__item" open={item.open}>
      <summary class="accordion__summary">
        <span class="accordion__title">
          {item.title}
        </span>

        <span class="accordion__icon" aria-hidden="true"></span>
      </summary>

      <div class="accordion__content">
        <p>{item.content}</p>
      </div>
    </details>
  ))}
</div>
---
/**
 * Before/after comparison of two photos (v3.13; custom sections' data-behavior="compare", src/sections/custom). With
 * JavaScript the "after" photo lies over the "before" one and a slider moves the line between them: a native range input
 * (keyboard, touch, screen readers) over the photos. Without JavaScript the two stand side by side with their labels.
 * The position goes into a constructed style sheet, never a style="" attribute (CSP).
 *   <Compare before={getAsset(content.before)} after={getAsset(content.after)} aspect={[4, 3]} />
 */
import Img from "@/components/media/Img.astro";
import { t } from "@/i18n";
import type { ResolvedAsset } from "@/site/assets";
import "@/styles/components/_compare.scss";

export interface Props {
  before: ResolvedAsset;
  after: ResolvedAsset;
  /** By default "before" / "after" in the site's language. */
  beforeLabel?: string;
  afterLabel?: string;
  aspect?: readonly [number, number];
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  before,
  after,
  beforeLabel = t.compare.before,
  afterLabel = t.compare.after,
  aspect = [4, 3],
  widths = [480, 720, 960, 1280],
  sizes = "(min-width: 768px) 50vw, 100vw",
  class: className,
} = Astro.props;
---

<div class:list={["compare", className]} data-compare>
  <figure class="compare__item compare__item--before">
    <Img src={before.image} alt={before.alt} kind={before.alt ? "content" : "decorative"} aspect={aspect} focal={before.focal} widths={widths} sizes={sizes} class="compare__image" />
    <figcaption class="compare__label">{beforeLabel}</figcaption>
  </figure>
  <figure class="compare__item compare__item--after">
    <Img src={after.image} alt={after.alt} kind={after.alt ? "content" : "decorative"} aspect={aspect} focal={after.focal} widths={widths} sizes={sizes} class="compare__image" />
    <figcaption class="compare__label compare__label--after">{afterLabel}</figcaption>
  </figure>
  <input class="compare__range" type="range" min="0" max="100" value="50" aria-label={`${t.compare.label}: ${beforeLabel} / ${afterLabel}`} hidden data-compare-range />
  <span class="compare__handle" aria-hidden="true"></span>
</div>

<script>
  // One constructed sheet for every compare on the page: a rule per compare with its position.
  let sheet: CSSStyleSheet | undefined;
  const positions = new Map<string, string>();

  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((compare, index) => {
    const range = compare.querySelector<HTMLInputElement>("[data-compare-range]");
    if (!range) return;

    if (!sheet) {
      sheet = new CSSStyleSheet();
      document.adoptedStyleSheets = [...document.adoptedStyleSheets, sheet];
    }

    const id = String(index + 1);
    compare.dataset.compare = id;
    const update = () => {
      positions.set(id, `[data-compare="${id}"] { --compare-position: ${Number(range.value)}%; }`);
      sheet?.replaceSync([...positions.values()].join("\n"));
    };

    range.hidden = false;
    compare.classList.add("compare--live");
    range.addEventListener("input", update);
    update();
  });
</script>

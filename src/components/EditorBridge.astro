---
/**
 * v3.6: editor preview bridge, only in preview builds for the factory editor (PREVIEW_EDITOR_ORIGIN,
 * "virtual:editor-bridge"; production builds do not import it). In the editor's iframe the page
 * lists its sections, follows the panel (section order and visibility without a reload, the section
 * in focus) and reports clicks on sections. v3.11: a click on a button reports its kind (and does
 * nothing else), the editor highlights a kind and shows a button style live (theme.buttons, the same
 * custom properties the build makes). Messages go to the editor's origin only, and only the
 * editor (the parent window, its origin) is listened to. Opened outside a frame, the page works as
 * usual. Protocol: README "Editor Preview Bridge".
 */
import "@/styles/state/_editor-bridge.scss";
import { site } from "virtual:site";
import { resolveTheme } from "@/design-system/theme";
import type { ButtonPalette } from "@/design-system/theme/buttons";

interface Props {
  /** The editor's origin, e.g. https://factory.mytko.dev. */
  origin: string;
}

const { origin } = Astro.props;
// v3.12: a style shown live is fixed like the build fixes it (cssVars.ts): on the palette of the scheme the site
// shows first, unless the operator keeps the site's colors (theme.allowLowContrastButtons).
const theme = resolveTheme(site.theme);
const { background, border, action } = theme.colorScheme === "dark" ? theme.dark : theme.light;
const ownPalette: ButtonPalette = { background: { primary: background.primary, muted: background.muted }, border: { default: border.default }, action };
---

<span hidden data-editor-origin={origin} data-button-palette={site.theme.allowLowContrastButtons ? undefined : JSON.stringify(ownPalette)}></span>

<script>
  import { buttonKindOf, parseEditorMessage, sectionOrder, type BridgeSection } from "@/site/editor-bridge";
  import { BUTTON_KINDS, buttonColorVars, buttonVars, fixButtonStyles, vanishingKinds, type ButtonPalette, type ButtonStyles } from "@/design-system/theme/buttons";

  const FOCUS = "is-editor-focus";
  // The page's sections (SectionShell) in their current order.
  const sections = () => [...document.querySelectorAll<HTMLElement>("main > [data-section-type]")];

  // The parts of the page with their own palette (design-system/utils/cssVars.ts): there a kind's
  // colors stay only where they would not vanish, as in the build.
  const SCOPES = [
    ".section--tone-inverse", ".section--tone-accent", ".site-footer--tone-brand", ".site-footer__brand-surface",
    ".site-header--brand-bar", ".section.s-hero--cover-image", ".lightbox", ".site-footer--tone-dark",
    ".site-footer__band--image", ".site-header--dark-bar", ".site-footer--tone-light",
  ].join(", ");
  // v3.12: the palette the build fixes a style's failing colors on (none: the operator keeps them).
  const paletteData = document.querySelector("[data-editor-origin]")?.getAttribute("data-button-palette");
  const ownPalette = paletteData ? (JSON.parse(paletteData) as ButtonPalette) : undefined;
  const PROPERTIES = ["padding-x-sm", "padding-x-md", "padding-x-lg", "padding-y", "border-width", "radius", "weight", "case", "tracking", "shadow", "lift", "glow"];
  const ALL_VARS = BUTTON_KINDS.flatMap((kind) => [...buttonColorVars(kind), ...PROPERTIES.map((name) => `button-${kind}-${name}`)]);
  const HEX = /^#[0-9a-f]{6}$/i;

  /** The palette an element's buttons are drawn with (its color tokens), or undefined when unreadable. */
  function paletteOf(element: Element): ButtonPalette | undefined {
    const style = getComputedStyle(element);
    const token = (name: string) => style.getPropertyValue(`--color-${name}`).trim();
    const palette = {
      background: { primary: token("background-primary"), muted: token("background-muted") },
      border: { default: token("border-default") },
      action: {
        primary: token("action-primary"), primaryHover: token("action-primary-hover"), primaryText: token("action-primary-text"),
        secondary: token("action-secondary"), secondaryHover: token("action-secondary-hover"), secondaryText: token("action-secondary-text"),
      },
    };
    const values = [palette.background.primary, palette.background.muted, palette.border.default, ...Object.values(palette.action)];
    return values.every((value) => HEX.test(value)) ? palette : undefined;
  }

  /**
   * A button style shown live: every button custom property set inline on the page (what the style
   * leaves out as "initial", so the built style does not show through) and, in each part with its own
   * palette, the kinds' colors kept or reset like the build does. null: back to the built style.
   */
  function showButtonStyles(sent: ButtonStyles | null) {
    const root = document.documentElement;
    const scopes = [...document.querySelectorAll<HTMLElement>(SCOPES)];
    for (const element of [root, ...scopes]) for (const name of ALL_VARS) element.style.removeProperty(`--${name}`);
    if (!sent) return;

    const styles = ownPalette ? (fixButtonStyles(sent, ownPalette).styles ?? sent) : sent;
    const vars = buttonVars(styles);
    for (const name of ALL_VARS) root.style.setProperty(`--${name}`, vars[name] ?? "initial");

    // An "auto" site seen in the dark scheme: the page itself is the other scheme's palette. Parts in the
    // page's own palette (a dark footer on a dark site) follow the page, as in the build.
    const foreignRoot = !root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches;
    const own = foreignRoot ? "" : JSON.stringify(paletteOf(root));
    for (const element of foreignRoot ? [root, ...scopes] : scopes) {
      const palette = paletteOf(element);
      if (!palette || JSON.stringify(palette) === own) continue;
      const vanishing = vanishingKinds(styles, palette);
      for (const kind of BUTTON_KINDS) {
        for (const name of buttonColorVars(kind)) element.style.setProperty(`--${name}`, vars[name] && !vanishing.includes(kind) ? vars[name] : "initial");
      }
    }
  }

  function highlightButtons(kind: string | null) {
    if (kind) document.documentElement.dataset.editorButtons = kind;
    else delete document.documentElement.dataset.editorButtons;
  }

  function start(origin: string) {
    const post = (message: object) => window.parent.postMessage(message, origin);
    let focused: HTMLElement | undefined;

    post({
      type: "factory:ready",
      page: location.pathname,
      // v3.11: what this engine's bridge can do beyond sections.
      features: ["buttons"],
      sections: sections().map((section): BridgeSection => ({
        id: section.id,
        type: section.dataset.sectionType ?? "",
        variant: section.dataset.sectionVariant ?? "",
        title: section.querySelector("h1, h2")?.textContent?.replace(/\s+/g, " ").trim() || null,
      })),
    });

    window.addEventListener("message", (event) => {
      if (event.origin !== origin || event.source !== window.parent) return;
      const message = parseEditorMessage(event.data);

      if (message?.type === "factory:layout") {
        const byId = new Map(sections().map((section) => [section.id, section]));
        const [first, ...rest] = sectionOrder([...byId.keys()], message.order).map((id) => byId.get(id) as HTMLElement);
        // The first section keeps its place (it has the page's <h1>), the others follow it in the new order.
        first?.after(...rest);
        for (const [id, section] of byId) section.hidden = message.hidden.includes(id);
        post({ type: "factory:layout-applied" });
      }

      if (message?.type === "factory:focus") {
        focused?.classList.remove(FOCUS);
        focused = sections().find((section) => section.id === message.id);
        focused?.classList.add(FOCUS);
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        focused?.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      }

      if (message?.type === "factory:button-style") {
        showButtonStyles(message.styles);
        post({ type: "factory:button-style-applied" });
      }

      if (message?.type === "factory:focus-buttons") highlightButtons(message.kind);
    });

    // Links do not leave the page (other pages, tel:, mailto:, new tabs): the panel is the place to
    // edit. Links within the page, buttons, forms and widgets work as usual; any click inside a
    // section selects it. v3.11: a button the site styles (a kind of theme.buttons) does nothing on a
    // click, not even its form or its frame: its kind is highlighted and reported instead.
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : undefined;
      const kind = buttonKindOf(target);
      if (kind) {
        event.preventDefault();
        event.stopPropagation();
        highlightButtons(kind);
        post({ type: "factory:button", kind, section: target?.closest<HTMLElement>("main > [data-section-type]")?.id ?? null });
        return;
      }

      const link = target?.closest("a[href]");
      const withinPage = link instanceof HTMLAnchorElement && link.hash && link.origin === location.origin && link.pathname === location.pathname && !link.target;
      if (link && !withinPage) event.preventDefault();

      const section = target?.closest<HTMLElement>("main > [data-section-type]");
      if (section) post({ type: "factory:select", id: section.id });
    }, { capture: true });
  }

  const origin = document.querySelector("[data-editor-origin]")?.getAttribute("data-editor-origin");
  if (origin && window.parent !== window) start(origin);
</script>

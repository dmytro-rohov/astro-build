---
import NewTab from "@/components/ui/NewTab.astro";
import { t } from "@/i18n";

export interface Props {
  href: string;
  variant?: "default" | "muted" | "underline" | "nav";
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "default",
  external = false,
  class: className,
  ariaLabel,
  ...restProps
} = Astro.props;

const isExternal =
  external ||
  href.startsWith("http://") ||
  href.startsWith("https://");

const rel = isExternal ? "noopener noreferrer" : undefined;
const target = isExternal ? "_blank" : undefined;
// v3.12: a link to a new tab says so to screen readers (in its own name when it has one).
const label = ariaLabel && isExternal ? `${ariaLabel} ${t.common.newTab}` : ariaLabel;
---

<a
  {...restProps}
  class:list={[
    "link",
    `link--${variant}`,
    className,
  ]}
  href={href}
  target={target}
  rel={rel}
  aria-label={label}
>
  <slot />{isExternal && !ariaLabel && <NewTab />}
</a>
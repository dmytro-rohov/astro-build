---
import type { SpaceToken } from "@/design-system/tokens/core/spacing";

type SidebarTag = "aside" | "div" | "section" | "main";

export interface Props {
  as?: SidebarTag;
  side?: "left" | "right";
  /** Sidebar column width: sm 16rem, md 20rem, lg 24rem. */
  width?: "sm" | "md" | "lg";
  gap?: SpaceToken;
  class?: string;
}

const {
  as: Tag = "div",
  side = "right",
  width = "md",
  gap = "xl",
  class: className,
  ...restProps
} = Astro.props;

---

<Tag
  {...restProps}
  class:list={[
    "sidebar",
    `sidebar--${side}`,
    `sidebar--width-${width}`,
    `sidebar--gap-${gap}`,
    className,
  ]}
>
  <slot />
</Tag>
---
import type { SpaceToken } from "@/design-system/tokens/core/spacing";

type ClusterTag = "div" | "nav" | "ul" | "ol";

export interface Props {
  as?: ClusterTag;
  gap?: SpaceToken;
  align?: "start" | "center" | "end" | "stretch";
  justify?: "start" | "center" | "end" | "between";
  class?: string;
}

const {
  as: Tag = "div",
  gap = "sm",
  align = "center",
  justify = "start",
  class: className,
  ...restProps
} = Astro.props;

---

<Tag
  {...restProps}
  class:list={[
    "cluster",
    `cluster--align-${align}`,
    `cluster--justify-${justify}`,
    `cluster--gap-${gap}`,
    className,
  ]}
>
  <slot />
</Tag>
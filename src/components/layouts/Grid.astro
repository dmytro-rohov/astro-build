---
import type { SpaceToken } from "@/design-system/tokens/core/spacing";

type GridTag = "div" | "section" | "ul" | "ol";

export interface Props {
  as?: GridTag;
  columns?: "1" | "2" | "3" | "4" | "auto";
  gap?: SpaceToken;
  class?: string;
}

const {
  as: Tag = "div",
  columns = "auto",
  gap = "lg",
  class: className,
  ...restProps
} = Astro.props;

---

<Tag
  {...restProps}
  class:list={[
    "grid",
    `grid--cols-${columns}`,
    `grid--gap-${gap}`,
    className,
  ]}
>
  <slot />
</Tag>
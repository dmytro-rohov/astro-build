---
import type { SpaceToken } from "@/design-system/tokens/core/spacing";

type StackTag = "div" | "section" | "article" | "ul" | "ol" | "form";

export interface Props {
  as?: StackTag;
  space?: SpaceToken;
  class?: string;
}

const {
  as: Tag = "div",
  space = "md",
  class: className,
  ...restProps
} = Astro.props;

---

<Tag
{...restProps}
class:list={[
  "stack",
  `stack--space-${space}`,
  className,
]}>

<slot />

</Tag>
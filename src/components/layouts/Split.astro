---
import type { SpaceToken } from "@/design-system/tokens/core/spacing";

type SplitTag = "div" | "section" | "article";

export interface Props {
  as?: SplitTag;
  ratio?: "equal" | "text-media" | "media-text" | "sidebar";
  gap?: SpaceToken;
  align?: "start" | "center" | "end" | "stretch";
  reverse?: boolean;
  class?: string;
}

const {
  as: Tag = "div",
  ratio = "equal",
  gap = "xl",
  align = "center",
  reverse = false,
  class: className,
  ...restProps
} = Astro.props;

---

<Tag
  {...restProps}
  class:list={[
    "split",
    `split--${ratio}`,
    `split--align-${align}`,
    reverse && "split--reverse",
    `split--gap-${gap}`,
    className,
  ]}
>
  <slot />
</Tag>
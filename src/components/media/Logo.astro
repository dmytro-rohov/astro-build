---
/**
 * Site logo from site.json (meta.logo), or the business name as a text logo.
 * The logo is the only content of the home link, so its alt is the site name.
 */
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import { site } from "virtual:site";

export interface Props {
  /** Rendered logo height: header (smaller) or footer. */
  size?: "header" | "footer";
  class?: string;
}

const { size = "header", class: className } = Astro.props;

const logo = site.meta.logo ? getAsset(site.meta.logo) : undefined;
const isSvg = logo?.image.format === "svg";
---

{logo ? (
  isSvg ? (
    <img
      class:list={["logo", `logo--${size}`, className]}
      src={logo.image.src}
      width={logo.image.width}
      height={logo.image.height}
      alt={site.meta.name}
    />
  ) : (
    <Img
      src={logo.image}
      alt={site.meta.name}
      class:list={["logo", `logo--${size}`, className].filter(Boolean).join(" ")}
      widths={[160, 320, 480]}
      sizes="160px"
      priority={size === "header" ? "high" : "auto"}
    />
  )
) : (
  <span class:list={["logo-text", `logo-text--${size}`, className]}>{site.meta.name}</span>
)}

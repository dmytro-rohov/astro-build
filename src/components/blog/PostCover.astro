---
/**
 * v3.9: a post's main photo (the cover, else its first photo) cropped for a list or a page. In
 * lists it is decorative (the linked title says it all). Without any photo: a brand-colored tile
 * with the title's first letter, in the same proportions.
 */
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import { postImage } from "@/site/blog";
import type { Post } from "@/site/schema/blog";
import "@/styles/blog/_cover.scss";

export interface Props {
  post: Post;
  aspect?: readonly [number, number];
  widths?: number[];
  sizes: string;
  priority?: "auto" | "high";
  /** The photo says something of its own (a post page): keep its alt text. */
  content?: boolean;
  class?: string;
}

const { post, aspect = [3, 2], widths = [400, 640, 960], sizes, priority = "auto", content = false, class: className } = Astro.props;
const ref = postImage(post);
const photo = ref ? getAsset(ref) : undefined;
const ratio = `post-cover--${aspect[0]}x${aspect[1]}`;
---

{photo ? (
  <Img
    src={photo.image}
    alt={content ? photo.alt : ""}
    kind={content && photo.alt ? "content" : "decorative"}
    aspect={aspect}
    focal={photo.focal}
    widths={widths}
    sizes={sizes}
    priority={priority}
    class:list={["post-cover", ratio, className]}
  />
) : (
  <span class:list={["post-cover", "post-cover--empty", ratio, className]} aria-hidden="true">
    <span class="post-cover__letter">{post.title.charAt(0)}</span>
  </span>
)}

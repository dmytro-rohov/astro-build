---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Split from "@/components/layouts/Split.astro";
import Stack from "@/components/layouts/Stack.astro";

import Card from "@/components/ui/Card.astro";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";

import FormGroup from "@/components/form/FormGroup.astro";
import FormField from "@/components/form/FormField.astro";
import Label from "@/components/form/Label.astro";
import FieldHint from "@/components/form/FieldHint.astro";
import FieldError from "@/components/form/FieldError.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Checkbox from "@/components/form/Checkbox.astro";

import { CONTACT_LIMITS } from "@/lib/contact/limits";
import { t } from "@/i18n";

const m = t.contactForm;

export type ContactInfoItem = {
  label: string;
  value: string;
  href?: string;
};

export interface Props {
  /** Section id, used as an anchor (e.g. /#features). */
  id?: string;
  eyebrow?: string;
  title?: string;
  /** Use "h1" when the form is the main section of the page (e.g. /contact). */
  headingLevel?: "h1" | "h2";
  description?: string;
  contactInfo?: ContactInfoItem[];
  action?: string;
  method?: "post";
  submitLabel?: string;
  privacyHref?: string;
  tone?: "default" | "muted" | "inverse" | "accent";
  /** Extra hidden fields sent with the form (e.g. siteId for the form service). */
  hiddenFields?: Record<string, string>;
  /** split: text + details beside the form; centered: one narrow column. */
  layout?: "split" | "centered";
  class?: string;
}

const {
  eyebrow = m.eyebrow,
  title = m.title,
  headingLevel = "h2",
  description = m.description,
  contactInfo = [
    {
      label: m.emailLabel,
      value: "hello@example.com",
      href: "mailto:hello@example.com",
    },
  ],
  action = "/api/contact",
  method = "post",
  submitLabel = m.submit,
  privacyHref = "/privacy",
  tone = "default",
  layout = "split",
  hiddenFields = {},
  class: className,
  ...restProps
} = Astro.props;

const hasContactInfo = contactInfo.length > 0;
const Layout = layout === "split" ? Split : Stack;
const layoutProps = layout === "split"
  ? ({ ratio: "sidebar", gap: "2xl", align: "start" } as const)
  : ({ space: "xl" } as const);
const Heading = headingLevel;
const SubHeading = headingLevel === "h1" ? "h2" : "h3";
---

<Section
  {...restProps}
  spacing="lg"
  tone={tone}
  class:list={[
    "contact-form-section",
    `contact-form-section--tone-${tone}`,
    className,
  ]}
>
  <Container size={layout === "split" ? "lg" : "sm"}>
    <Layout {...layoutProps} class:list={[layout === "centered" && "contact-form-section--centered"]}>
      <Stack class="contact-form-section__content" space="lg">
        <Stack space="md">
          {eyebrow && (
            <p class="contact-form-section__eyebrow">
              {eyebrow}
            </p>
          )}

          <Heading class="contact-form-section__title">
            {title}
          </Heading>

          {description && (
            <p class="contact-form-section__description">
              {description}
            </p>
          )}
        </Stack>

        {hasContactInfo && (
          <div class="contact-form-section__info">
            <SubHeading class="contact-form-section__info-title">
              {m.detailsTitle}
            </SubHeading>

            <ul class="contact-form-section__info-list">
              {contactInfo.map((item) => (
                <li class="contact-form-section__info-item">
                  <span class="contact-form-section__info-label">
                    {item.label}
                  </span>

                  {item.href ? (
                    <Link href={item.href} class="contact-form-section__info-link">
                      {item.value}
                    </Link>
                  ) : (
                    <span class="contact-form-section__info-value">
                      {item.value}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </Stack>

      <Card as="div" variant="elevated" padding="lg" class="contact-form-card">
        <form
          class="contact-form"
          action={action}
          method={method}
          data-contact-form
          data-msg-sending={m.sending}
          data-msg-success={m.success}
          data-msg-correct-fields={m.correctFields}
          data-msg-generic-error={m.genericError}
        >
          <FormGroup gap="lg">
            <FormField>
              <Label for="contact-name" required>
                {m.nameLabel}
              </Label>

              <Input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength={CONTACT_LIMITS.nameMax}
                required
                describedby="contact-name-error"
              />

              <FieldError id="contact-name-error" class="contact-form__error" data-error-for="name" />
            </FormField>

            <FormField>
              <Label for="contact-email" required>
                {m.emailLabel}
              </Label>

              <Input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength={CONTACT_LIMITS.emailMax}
                required
                describedby="contact-email-hint contact-email-error"
              />

              <FieldHint id="contact-email-hint">
                {m.emailHint}
              </FieldHint>

              <FieldError id="contact-email-error" class="contact-form__error" data-error-for="email" />
            </FormField>

            <FormField>
              <Label for="contact-subject">
                {m.subjectLabel}
              </Label>

              <Input
                id="contact-subject"
                name="subject"
                type="text"
                autocomplete="off"
                maxlength={CONTACT_LIMITS.subjectMax}
                describedby="contact-subject-error"
              />

              <FieldError id="contact-subject-error" class="contact-form__error" data-error-for="subject" />
            </FormField>

            <FormField>
              <Label for="contact-message" required>
                {m.messageLabel}
              </Label>

              <Textarea
                id="contact-message"
                name="message"
                rows={6}
                maxlength={CONTACT_LIMITS.messageMax}
                required
                describedby="contact-message-error"
              />

              <FieldError id="contact-message-error" class="contact-form__error" data-error-for="message" />
            </FormField>

            {Object.entries(hiddenFields).map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}

            <div class="contact-form__honeypot" aria-hidden="true">
              <Label for="contact-website">
                {m.honeypotLabel}
              </Label>

              <Input
                id="contact-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <FormField>
              <Checkbox
                id="contact-privacy"
                name="privacy"
                required
                describedby="contact-privacy-error"
              >
                {m.privacyBefore}{" "}
                <Link href={privacyHref}>
                  {m.privacyLink}
                </Link>
                {m.privacyAfter}
              </Checkbox>

              <FieldError id="contact-privacy-error" class="contact-form__error" data-error-for="privacy" />
            </FormField>

            <p class="contact-form__status" data-contact-status aria-live="polite"></p>

            <Button type="submit" size="lg" class="contact-form__submit">
              {submitLabel}
            </Button>
          </FormGroup>
        </form>
      </Card>
    </Layout>
  </Container>
</Section>

<script>
  const forms = document.querySelectorAll("[data-contact-form]");

  forms.forEach((form) => {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    const status = form.querySelector("[data-contact-status]");
    const messages = form.dataset;
    const submit = form.querySelector('button[type="submit"]');

    const clearErrors = () => {
      form.querySelectorAll("[data-error-for]").forEach((node) => {
        node.textContent = "";
      });

      form.querySelectorAll("[aria-invalid='true']").forEach((node) => {
        node.removeAttribute("aria-invalid");
      });
    };

    const setFieldError = (field: string, message: string) => {
      const error = form.querySelector(`[data-error-for="${field}"]`);
      const input = form.querySelector(`[name="${field}"]`);

      if (error) {
        error.textContent = message;
      }

      if (input) {
        input.setAttribute("aria-invalid", "true");
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      clearErrors();

      if (status) {
        status.textContent = messages.msgSending ?? "";
        status.setAttribute("data-state", "pending");
      }

      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
      }

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          if (Array.isArray(result.errors)) {
            result.errors.forEach((error: { field: string; message: string }) => {
              setFieldError(error.field, error.message);
            });

            // Move focus to the first invalid field so keyboard and screen reader
            // users land where the problem is.
            form.querySelector<HTMLElement>("[aria-invalid='true']")?.focus();
          }

          if (status) {
            status.textContent = result.message || messages.msgCorrectFields || "";
            status.setAttribute("data-state", "error");
          }

          return;
        }

        form.reset();

        if (status) {
          status.textContent = result.message || messages.msgSuccess || "";
          status.setAttribute("data-state", "success");
        }
      } catch (error) {
        console.error(error);

        if (status) {
          status.textContent = messages.msgGenericError ?? "";
          status.setAttribute("data-state", "error");
        }
      } finally {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
        }
      }
    });
  });
</script>
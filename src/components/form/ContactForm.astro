---
/**
 * The contact form: its fields (the site's contact.form.fields, else the form as before 3.8: name, e-mail, subject,
 * message), consent, honeypot, status line and the script that sends it with fetch (server field errors next to the
 * fields, focus on the first invalid one). Without JavaScript the browser posts it and the server redirects to a result
 * page. The section layouts around it are the contact variants (src/sections/contact/).
 */
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/media/Icon.astro";

import FormGroup from "@/components/form/FormGroup.astro";
import FormField from "@/components/form/FormField.astro";
import Label from "@/components/form/Label.astro";
import FieldHint from "@/components/form/FieldHint.astro";
import FieldError from "@/components/form/FieldError.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Checkbox from "@/components/form/Checkbox.astro";
import Select from "@/components/form/Select.astro";

import { autocompleteOf, DEFAULT_FIELDS, hasHint, maxLengthOf, type FormField as Field } from "@/lib/contact/fields";
import { fieldLabel } from "@/lib/contact/validateContactForm";
import { t } from "@/i18n";

const m = t.contactForm;

export interface Props {
  action?: string;
  method?: "post";
  submitLabel?: string;
  privacyHref?: string;
  /** The form's fields in order (lib/contact/fields.ts); the default form when not given. */
  fields?: readonly Field[];
  /** Extra hidden fields sent with the form (e.g. siteId for the form service). */
  hiddenFields?: Record<string, string>;
  class?: string;
}

const {
  action = "/api/contact",
  method = "post",
  submitLabel = m.submit,
  privacyHref = "/privacy",
  fields = DEFAULT_FIELDS,
  hiddenFields = {},
  class: className,
} = Astro.props;

/** The hint under a field: its own, or the dictionary's for the default e-mail field. A minimum length is the server's
 * to check (its message speaks the site's language; a minlength attribute would bring the browser's own). */
const hintOf = (field: Field) => field.hint ?? (hasHint(field) ? m.emailHint : undefined);
const describedBy = (field: Field) => [hintOf(field) ? `contact-${field.id}-hint` : "", `contact-${field.id}-error`].filter(Boolean).join(" ");
const INPUT_TYPES = ["text", "email", "tel", "date", "number"] as const;
---

<form
  class:list={["contact-form", className]}
  action={action}
  method={method}
  data-contact-form
  data-msg-sending={m.sending}
  data-msg-success={m.success}
  data-msg-correct-fields={m.correctFields}
  data-msg-generic-error={m.genericError}
>
  <FormGroup gap="lg" class="contact-form__fields">
    {fields.map((field) => (
      <FormField class:list={[field.width === "half" && "contact-form__field--half", `contact-form__field--${field.type}`]}>
        {field.type === "checkbox" ? (
          <Checkbox id={`contact-${field.id}`} name={field.id} required={field.required} describedby={describedBy(field)}>
            {fieldLabel(field)}{field.required && <span class="contact-form__required" aria-hidden="true"> *</span>}
          </Checkbox>
        ) : (
          <Fragment>
            <Label for={`contact-${field.id}`} required={field.required}>
              {fieldLabel(field)}
            </Label>

            <div class:list={["contact-form__control", field.icon && "contact-form__control--icon"]}>
              {field.icon && <Icon name={field.icon} class="contact-form__icon" />}

              {field.type === "textarea" ? (
                <Textarea
                  id={`contact-${field.id}`}
                  name={field.id}
                  rows={6}
                  placeholder={field.placeholder}
                  maxlength={maxLengthOf(field)}
                  required={field.required}
                  describedby={describedBy(field)}
                />
              ) : field.type === "select" ? (
                <Select id={`contact-${field.id}`} name={field.id} required={field.required} describedby={describedBy(field)}>
                  <option value="">{field.placeholder ?? m.selectPlaceholder}</option>
                  {(field.options ?? []).map((option) => <option value={option}>{option}</option>)}
                </Select>
              ) : (
                <Input
                  id={`contact-${field.id}`}
                  name={field.id}
                  type={(INPUT_TYPES as readonly string[]).includes(field.type) ? (field.type as (typeof INPUT_TYPES)[number]) : "text"}
                  inputmode={field.type === "number" ? "decimal" : undefined}
                  step={field.type === "number" ? "any" : undefined}
                  placeholder={field.placeholder}
                  autocomplete={autocompleteOf(field)}
                  maxlength={field.type === "date" || field.type === "number" ? undefined : maxLengthOf(field)}
                  required={field.required}
                  describedby={describedBy(field)}
                />
              )}
            </div>
          </Fragment>
        )}

        {hintOf(field) && (
          <FieldHint id={`contact-${field.id}-hint`}>
            {hintOf(field)}
          </FieldHint>
        )}

        <FieldError id={`contact-${field.id}-error`} class="contact-form__error" data-error-for={field.id} />
      </FormField>
    ))}

    {Object.entries(hiddenFields).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}

    <div class="contact-form__honeypot" aria-hidden="true">
      <Label for="contact-website">
        {m.honeypotLabel}
      </Label>

      <Input
        id="contact-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <FormField>
      <Checkbox
        id="contact-privacy"
        name="privacy"
        required
        describedby="contact-privacy-error"
      >
        {m.privacyBefore}{" "}
        <Link href={privacyHref}>
          {m.privacyLink}
        </Link>
        {m.privacyAfter}
      </Checkbox>

      <FieldError id="contact-privacy-error" class="contact-form__error" data-error-for="privacy" />
    </FormField>

    <p class="contact-form__status" data-contact-status aria-live="polite"></p>

    <Button type="submit" size="lg" class="contact-form__submit">
      {submitLabel}
    </Button>
  </FormGroup>
</form>

<script>
  const forms = document.querySelectorAll("[data-contact-form]");

  forms.forEach((form) => {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    const status = form.querySelector("[data-contact-status]");
    // Read through attributes and the prototype: a control named like a form property ("action", "reset")
    // would shadow form.action or form.reset().
    const messages = {
      msgSending: form.getAttribute("data-msg-sending"),
      msgSuccess: form.getAttribute("data-msg-success"),
      msgCorrectFields: form.getAttribute("data-msg-correct-fields"),
      msgGenericError: form.getAttribute("data-msg-generic-error"),
    };
    const action = form.getAttribute("action") ?? "";
    const method = form.getAttribute("method") ?? "post";
    const submit = form.querySelector('button[type="submit"]');

    const clearErrors = () => {
      form.querySelectorAll("[data-error-for]").forEach((node) => {
        node.textContent = "";
      });

      form.querySelectorAll("[aria-invalid='true']").forEach((node) => {
        node.removeAttribute("aria-invalid");
      });
    };

    const setFieldError = (field: string, message: string) => {
      const error = form.querySelector(`[data-error-for="${field}"]`);
      const input = form.querySelector(`[name="${field}"]`);

      if (error) {
        error.textContent = message;
      }

      if (input) {
        input.setAttribute("aria-invalid", "true");
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      clearErrors();

      if (status) {
        status.textContent = messages.msgSending ?? "";
        status.setAttribute("data-state", "pending");
      }

      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
      }

      try {
        const response = await fetch(action, {
          method,
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          if (Array.isArray(result.errors)) {
            result.errors.forEach((error: { field: string; message: string }) => {
              setFieldError(error.field, error.message);
            });

            // Move focus to the first invalid field so keyboard and screen reader
            // users land where the problem is.
            form.querySelector<HTMLElement>("[aria-invalid='true']")?.focus();
          }

          if (status) {
            status.textContent = result.message || messages.msgCorrectFields || "";
            status.setAttribute("data-state", "error");
          }

          return;
        }

        HTMLFormElement.prototype.reset.call(form);

        if (status) {
          status.textContent = result.message || messages.msgSuccess || "";
          status.setAttribute("data-state", "success");
        }
      } catch (error) {
        console.error(error);

        if (status) {
          status.textContent = messages.msgGenericError ?? "";
          status.setAttribute("data-state", "error");
        }
      } finally {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
        }
      }
    });
  });
</script>
---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Button from "@/components/ui/Button.astro";
import { t } from "@/i18n";

const page = t.pages.serverError;
---

<BaseLayout
  title={page.title}
  description={page.description}
  robots="noindex, follow"
>
  <Section spacing="xl">
    <Container size="md">
      <Stack space="lg" class="error-page">
        <p class="error-page__code" aria-hidden="true">500</p>
        <h1>{page.heading}</h1>
        <p>{page.description}</p>
        <div>
          <Button href="/">{t.common.backToHome}</Button>
        </div>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

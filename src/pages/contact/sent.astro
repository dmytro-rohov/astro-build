---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Button from "@/components/ui/Button.astro";
import { t } from "@/i18n";

// Shown after the contact form is submitted without JavaScript.
const page = t.pages.contactSent;
---

<BaseLayout title={page.title} description={page.description}>
  <Section spacing="xl">
    <Container size="md">
      <Stack space="lg">
        <h1>{page.heading}</h1>
        <p>{page.description}</p>
        <div>
          <Button href="/">{t.common.backToHome}</Button>
        </div>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

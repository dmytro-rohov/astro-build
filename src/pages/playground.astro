---
import BaseLayout from "@/layouts/BaseLayout.astro";

import Hero from "@/components/widgets/Hero.astro";
import FeatureGrid from "@/components/widgets/FeatureGrid.astro";
import CTA from "@/components/widgets/CTA.astro";
import FAQ from "@/components/widgets/FAQ.astro";
import ContactForm from "@/components/widgets/ContactForm.astro";

const featureItems = [
  {
    eyebrow: "Tokens",
    title: "Design tokens",
    description:
      "Centralized values for colors, spacing, typography, radius, shadows and motion.",
    icon: "star",
  },
  {
    eyebrow: "Layout",
    title: "Layout primitives",
    description:
      "Reusable primitives like Section, Container, Stack, Cluster, Grid, Split and Sidebar.",
    icon: "grid",
  },
  {
    eyebrow: "Media",
    title: "Optimized media",
    description:
      "Reusable Img, Picture, Figure and Icon components prepared for production projects.",
    icon: "image",
  },
  {
    eyebrow: "Styles",
    title: "Clean SCSS architecture",
    description:
      "Global layers, design token usage and no duplicated local component CSS.",
    icon: "code",
  },
  {
    eyebrow: "Forms",
    title: "Backend-ready forms",
    description:
      "Form primitives and ContactForm prepared for Astro API routes and future email delivery.",
    icon: "mail",
  },
  {
    eyebrow: "Widgets",
    title: "Reusable sections",
    description:
      "Ready-to-use landing page sections like Hero, FeatureGrid, CTA, FAQ and ContactForm.",
    icon: "blocks",
  },
];

const faqItems = [
  {
    title: "What is this playground page for?",
    content:
      "This page is used to preview and test all reusable widgets in one place during development.",
    open: true,
  },
  {
    title: "Should playground be used as the homepage?",
    content:
      "No. The homepage should be a clean demo landing page. Playground is only for testing components and widgets.",
  },
  {
    title: "Can these widgets be customized per project?",
    content:
      "Yes. Use props for common changes and custom classes with widget-specific SCSS for project-specific adjustments.",
  },
  {
    title: "Does ContactForm already use backend?",
    content:
      "Yes. The widget posts to /api/contact. In development, the delivery mode can log submissions to the console.",
  },
];
---

<BaseLayout
  title="Playground | Astro Builder"
  description="Development playground for testing all Astro Builder widgets."
>
  <!--
    WIDGET 1: Hero

    Hero is the main landing section.
    It usually contains eyebrow, title, description, CTA actions and optional media.
  -->
  <Hero
    eyebrow="Widget 01"
    title="Hero widget preview."
    description="This is the main intro section. It combines Section, Container, Split, Stack, Cluster, Tag, Button, Link and media primitives."
    align="left"
    primaryAction={{
      label: "Primary action",
      href: "/contact",
    }}
    secondaryAction={{
      label: "Secondary link",
      href: "/",
    }}
  />

  <!--
    WIDGET 2: FeatureGrid

    FeatureGrid is used for showing features, benefits or system modules.
    It uses Grid and Card under the hood.
  -->
  <FeatureGrid
    eyebrow="Widget 02"
    title="FeatureGrid widget preview."
    description="This section presents multiple features in a responsive grid."
    items={featureItems}
    columns="3"
    tone="muted"
  />

  <!--
    WIDGET 3: CTA

    CTA is a conversion section.
    Use it when you want to guide the user to the next action.
  -->
  <CTA
    eyebrow="Widget 03"
    title="CTA widget preview."
    description="Use this section to move the user toward a specific action like contact, booking or project start."
    primaryAction={{
      label: "Start project",
      href: "/contact",
    }}
    secondaryAction={{
      label: "Back home",
      href: "/",
    }}
    boxed
  />

  <!--
    WIDGET 4: FAQ

    FAQ uses Accordion internally.
    Accordion is based on native details/summary and works without JavaScript.
  -->
  <FAQ
    eyebrow="Widget 04"
    title="FAQ widget preview."
    description="This section answers common questions using the reusable Accordion component."
    items={faqItems}
    accordionVariant="default"
    tone="default"
  />

  <!--
    WIDGET 5: ContactForm

    ContactForm is the full contact widget.
    It posts to /api/contact and can use console delivery during development.
  -->
  <ContactForm
    eyebrow="Widget 05"
    title="ContactForm widget preview."
    description="This form is connected to the local Astro API route. During development, submissions can be logged in the terminal."
    contactInfo={[
      {
        label: "Email",
        value: "hello@example.com",
        href: "mailto:hello@example.com",
      },
      {
        label: "Location",
        value: "Wrocław, Poland",
      },
    ]}
    action="/api/contact"
    method="post"
    submitLabel="Send test message"
    privacyHref="/privacy"
    tone="muted"
  />

  <!--
    SITE WIDGETS NOTE:

    Header/Navbar and SiteFooter are usually not placed manually here,
    because they are already rendered globally by BaseLayout.

    If you ever need to test them independently, create a separate shell-test page
    or temporarily render them outside BaseLayout.
  -->
</BaseLayout>
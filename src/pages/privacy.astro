---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
---

<BaseLayout
  title="Privacy Policy | Astro Builder"
  description="Basic privacy policy placeholder."
>
  <Section>
    <Container size="md">
      <Stack space="md">
        <h1>Privacy Policy</h1>
        <p>
          This is a placeholder privacy policy page. Replace it with project-specific
          legal content before production deployment.
        </p>
      </Stack>
    </Container>
  </Section>
</BaseLayout>
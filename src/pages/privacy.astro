---
/**
 * Privacy policy generated from business data and the language dictionary.
 * It is a TEMPLATE: the build report flags it for legal review before launch.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Link from "@/components/ui/Link.astro";
import { ANALYTICS_CONFIG } from "@/config/analytics";
import { format, lang, t } from "@/i18n";
import { site } from "virtual:site";
import { embedProvider } from "@/site/embeds";

const p = t.pages.privacy;
const { business } = site;
// Providers of the site's embed sections (maps, booking, video).
const embedProviders = [
  ...new Set(
    site.pages.flatMap((page) => page.sections).flatMap((section) => (section.type === "embed" ? [embedProvider(section.content.url)?.label ?? ""] : [])),
  ),
].filter(Boolean);
const name = business.name ?? site.meta.name;
const address = [business.address?.street, [business.address?.postalCode, business.address?.city].filter(Boolean).join(" ")]
  .filter(Boolean)
  .join(", ");
// Only a real change of the policy should move the date: set meta.privacyUpdated.
const updated = new Intl.DateTimeFormat(lang, { dateStyle: "long" }).format(
  site.meta.privacyUpdated ? new Date(`${site.meta.privacyUpdated}T12:00:00`) : new Date(),
);
---

<BaseLayout title={p.title} description={format(p.description, { name })}>
  <Section>
    <Container size="md">
      <Stack space="xl" class="privacy">
        <h1>{p.heading}</h1>

        <Stack space="sm">
          <h2>{p.controllerHeading}</h2>
          <p>{format(p.controllerText, { name, address: address ? `, ${address}` : "" })}</p>
          {business.email && (
            <p>
              {p.contactText.split("{email}")[0]}<Link href={`mailto:${business.email}`}>{business.email}</Link>{p.contactText.split("{email}")[1]}
            </p>
          )}
        </Stack>

        <Stack space="sm">
          <h2>{p.dataHeading}</h2>
          <p>{p.dataText}</p>
        </Stack>

        <Stack space="sm">
          <h2>{p.purposeHeading}</h2>
          <p>{p.purposeText}</p>
        </Stack>

        <Stack space="sm">
          <h2>{p.retentionHeading}</h2>
          <p>{p.retentionText}</p>
        </Stack>

        <Stack space="sm">
          <h2>{p.rightsHeading}</h2>
          <p>{p.rightsText}</p>
        </Stack>

        <Stack space="sm">
          <h2>{p.cookiesHeading}</h2>
          {ANALYTICS_CONFIG.enabled ? (
            <>
              <p>{p.cookiesText}</p>
              <p>
                <button type="button" class="link link--underline" data-cookie-settings>
                  {t.footer.cookieSettings}
                </button>
              </p>
            </>
          ) : (
            <p>{p.noCookiesText}</p>
          )}
          {embedProviders.length > 0 && <p>{format(p.embedsText, { providers: embedProviders.join(", ") })}</p>}
        </Stack>

        <p class="privacy__updated">{format(p.updated, { date: updated })}</p>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

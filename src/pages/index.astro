---
import BaseLayout from "@/layouts/BaseLayout.astro";

import Hero from "@/components/widgets/Hero.astro";
import FeatureGrid from "@/components/widgets/FeatureGrid.astro";
import CTA from "@/components/widgets/CTA.astro";
import FAQ from "@/components/widgets/FAQ.astro";

// for SEO
const siteUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL("/", siteUrl).toString();
const websiteImageUrl = new URL(
  "/og-cover.jpg",
  siteUrl,
).toString();

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Website",
  description: "Website description.",
  image: websiteImageUrl,

  isPartOf: {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    url: siteUrl.toString(),
    name: "Website",
  },

  primaryImageOfPage: {
    "@type": "ImageObject",
    url: defaultImageUrl,
  },
};

const features = [
  {
    eyebrow: "Core",
    title: "Design tokens",
    description:
      "Stable token names for colors, spacing, typography, radius, shadows and motion. Change values per project without rewriting components.",
  },
  {
    eyebrow: "Layout",
    title: "Layout primitives",
    description:
      "Compose pages with Container, Section, Stack, Cluster, Grid, Split and Sidebar instead of writing layout CSS from zero.",
  },
  {
    eyebrow: "Media",
    title: "Optimized media",
    description:
      "Reusable media components for images, pictures, figures and SVG sprite icons.",
  },
  {
    eyebrow: "UI",
    title: "Reusable components",
    description:
      "Button, Link, Card, Tag, Divider, Accordion and form primitives prepared for landing page development.",
  },
  {
    eyebrow: "Widgets",
    title: "Ready sections",
    description:
      "Use ready-made widgets like Hero, FeatureGrid, CTA, FAQ and ContactForm to build pages faster.",
  },
  {
    eyebrow: "Backend",
    title: "Contact form workflow",
    description:
      "A backend-ready ContactForm with Astro API route, validation and console delivery for development.",
  },
];

const faqItems = [
  {
    title: "What is Astro Builder?",
    content:
      "Astro Builder is a reusable frontend system for building landing pages and small websites faster with Astro, SCSS, design tokens and ready-made widgets.",
    open: true,
  },
  {
    title: "Do I need to recreate design tokens for every project?",
    content:
      "No. Keep token names stable and change their values to match the brand of each project.",
  },
  {
    title: "Can I build custom sections?",
    content:
      "Yes. Use the ready widgets for common cases or compose custom sections manually from layout, UI and media primitives.",
  },
  {
    title: "Is ContactForm backend-ready?",
    content:
      "Yes. It can post to an Astro API route and use console delivery during development. Email delivery can be added later through a provider.",
  },
];

// assets
import heroImage from "@/assets/img/photo.jpg";

---

<BaseLayout
  canonicalPath="/"
  image="/og-cover.jpg"
  imageAlt="Image alt text"
  robots="index, follow, max-image-preview:large"
  pageType="profile"
  jsonLd={pageJsonLd}
>
  <Hero
    eyebrow="Astro Frontend System"
    title="Build landing pages faster."
    description="Reusable Astro components, design tokens, optimized media, local fonts and clean SCSS architecture."
    image={heroImage}
    imageAlt="Preview of a modern landing page"
    primaryAction={{
      label: "Get started",
      href: "/#features",
    }}
    secondaryAction={{
      label: "View components",
      href: "/playground",
    }}
  />

  <FeatureGrid
    eyebrow="System overview"
    title="Everything you need to start a professional landing page."
    description="Astro Builder gives you a consistent foundation instead of rebuilding the same setup from scratch for every project."
    items={features}
    columns="3"
    tone="muted"
  />

  <CTA
    eyebrow="Ready to use"
    title="Start from a stronger base."
    description="Use ready widgets for common pages or compose your own custom sections from small, predictable primitives."
    primaryAction={{
      label: "Open playground",
      href: "/playground",
    }}
    secondaryAction={{
      label: "Test contact form",
      href: "/contact",
    }}
    boxed
  />

  <FAQ
    eyebrow="Questions"
    title="How this builder should be used."
    description="A short overview of the intended workflow for future projects."
    items={faqItems}
    accordionVariant="default"
  />

</BaseLayout>
---
import Container from "@/components/layouts/Container.astro";
import Navbar, { type NavItem, type NavAction } from "@/layouts/Navbar.astro";
import { siteConfig } from "@/config/site";
import Logo from "@/components/media/Logo.astro";
import Link from "@/components/ui/Link.astro";
import { site } from "virtual:site";
import { t } from "@/i18n";

export interface Props {
  brandHref?: string;
  navItems?: NavItem[];
  cta?: NavAction;
  sticky?: boolean;
  /** Slides away while scrolling down, comes back when scrolling up (sticky headers only). */
  hideOnScroll?: boolean;
  menuButton?: "label" | "icon";
  class?: string;
}

const {
  brandHref = "/",
  navItems = siteConfig.header.nav,
  cta = siteConfig.header.cta,
  sticky = siteConfig.header.sticky,
  hideOnScroll = siteConfig.header.hideOnScroll,
  menuButton = siteConfig.header.menuButton,
  class: className,
  ...restProps
} = Astro.props;

const variant = site.layout.navbar.variant;
const { phone, email } = site.business;
---

<header
  {...restProps}
  class:list={[
    "site-header",
    `site-header--${variant}`,
    sticky && "site-header--sticky",
    sticky && hideOnScroll && "site-header--hide-on-scroll",
    className,
  ]}
  data-hide-on-scroll={sticky && hideOnScroll ? "" : undefined}
>
  {variant === "topbar" && (phone || email) && (
    <div class="site-header__topbar">
      <Container size="xl">
        <ul class="site-header__contact" aria-label={t.sections.contactBar}>
          {phone && <li><Link href={`tel:${phone.replace(/[^\d+]/g, "")}`} variant="muted">{phone}</Link></li>}
          {email && <li class:list={[phone && "site-header__contact-secondary"]}><Link href={`mailto:${email}`} variant="muted">{email}</Link></li>}
        </ul>
      </Container>
    </div>
  )}
  <Container size="xl">
    <div class="site-header__inner">
      <a class="site-header__brand" href={brandHref}>
        <Logo size="header" />
      </a>

      <Navbar
        items={navItems}
        cta={cta}
        menuButton={menuButton}
        contact={variant === "topbar" ? { phone, email } : undefined}
        split={variant === "split"}
        overlay={variant === "minimal"}
      />
    </div>
  </Container>
</header>

<script>
  // v3.3: hides the sticky header while scrolling down, shows it again when scrolling up, near
  // the top, while its menu is open or when focus moves into it (keyboard users never lose it).
  const header = document.querySelector<HTMLElement>("[data-hide-on-scroll]");

  if (header) {
    const THRESHOLD = 6;
    let last = window.scrollY;
    let queued = false;

    const update = () => {
      queued = false;
      const y = window.scrollY;
      const delta = y - last;

      if (Math.abs(delta) < THRESHOLD) return;
      last = y;

      const keep = y <= header.offsetHeight || delta < 0 || header.querySelector("[data-navbar][data-open]") || header.contains(document.activeElement);
      header.toggleAttribute("data-hidden", !keep);
    };

    window.addEventListener("scroll", () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>

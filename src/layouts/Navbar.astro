---
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import { t } from "@/i18n";

export type NavItem = {
  label: string;
  href: string;
  external?: boolean;
};

export type NavAction = {
  label: string;
  href: string;
  external?: boolean;
};

export interface Props {
  items: NavItem[];
  cta?: NavAction;
  /** Phone and e-mail of the topbar: on phones the topbar is hidden and they appear in the menu. */
  contact?: { phone?: string; email?: string };
  /** Phone menu button: the word "Menu" with the icon, or the icon alone (v3.3). */
  menuButton?: "label" | "icon";
  /** v3.5 "split": the links in two lists, on both sides of the centered logo (wide screens). */
  split?: boolean;
  /** v3.5 "minimal": the full-screen menu on every screen; the button stays in the bar. */
  overlay?: boolean;
  label?: string;
  class?: string;
}

const {
  items,
  cta,
  contact,
  menuButton = "label",
  split = false,
  overlay = false,
  label = t.nav.label,
  class: className,
  ...restProps
} = Astro.props;

const currentPath = Astro.url.pathname;

function normalizePath(path: string) {
  if (path === "/") return "/";

  return path.replace(/\/$/, "");
}

function isActiveLink(href: string) {
  if (href.startsWith("http")) return false;
  if (href.startsWith("#")) return false;
  // Section links (/#features) point inside a page, not to the current page itself.
  if (href.includes("#")) return false;

  return normalizePath(href) === normalizePath(currentPath);
}

// Split navbar: the first half of the links left of the logo, the rest and the button (the last
// item of the second list) right of it.
const lists = split && items.length > 1
  ? [items.slice(0, Math.ceil(items.length / 2)), items.slice(Math.ceil(items.length / 2))]
  : [items];
---

<nav
  {...restProps}
  class:list={[
    "navbar",
    overlay && "navbar--overlay",
    className,
  ]}
  aria-label={label}
  data-navbar
>
  {overlay && cta && (
    <Button
      href={cta.href}
      external={cta.external}
      size="sm"
      class="navbar__cta navbar__cta--bar"
    >
      {cta.label}
    </Button>
  )}

  <button
    class:list={["navbar__toggle", `navbar__toggle--${menuButton}`]}
    type="button"
    aria-expanded="false"
    aria-controls="navbar-menu"
    data-navbar-toggle
  >
    <span class:list={["navbar__toggle-text", menuButton === "icon" && "visually-hidden"]}>{t.nav.menu}</span>
    <span class="navbar__icon" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div class="navbar__menu" id="navbar-menu" data-navbar-menu>
    {lists.map((list, index) => (
      <ul class:list={["navbar__list", lists.length > 1 && (index === 0 ? "navbar__list--start" : "navbar__list--end")]}>
        {list.map((item) => (
          <li class="navbar__item">
            <Link
              href={item.href}
              external={item.external}
              variant="nav"
              class="navbar__link"
              aria-current={isActiveLink(item.href) ? "page" : undefined}
            >
              {item.label}
            </Link>
          </li>
        ))}
        {split && cta && index === lists.length - 1 && (
          <li class="navbar__item navbar__item--cta">
            <Button href={cta.href} external={cta.external} size="sm" class="navbar__cta">
              {cta.label}
            </Button>
          </li>
        )}
      </ul>
    ))}

    {!split && cta && (
      <Button
        href={cta.href}
        external={cta.external}
        size="sm"
        class="navbar__cta"
      >
        {cta.label}
      </Button>
    )}

    {(contact?.phone || contact?.email) && (
      <ul class="navbar__contact" aria-label={t.sections.contactBar}>
        {contact.phone && <li><a class="navbar__contact-link" href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}>{contact.phone}</a></li>}
        {contact.email && <li><a class="navbar__contact-link" href={`mailto:${contact.email}`}>{contact.email}</a></li>}
      </ul>
    )}
  </div>
</nav>

<script>
  const navbars = document.querySelectorAll("[data-navbar]");

  navbars.forEach((navbar) => {
    const toggle = navbar.querySelector("[data-navbar-toggle]");
    const menu = navbar.querySelector("[data-navbar-menu]");

    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) {
      return;
    }

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const closeMenu = ({ returnFocus = false } = {}) => {
      if (!isOpen()) {
        return;
      }

      toggle.setAttribute("aria-expanded", "false");
      navbar.removeAttribute("data-open");

      if (returnFocus) {
        toggle.focus();
      }
    };

    const openMenu = () => {
      toggle.setAttribute("aria-expanded", "true");
      navbar.setAttribute("data-open", "");
    };

    toggle.addEventListener("click", () => {
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // A link, or the empty part of the full-screen phone menu, closes it.
    menu.addEventListener("click", (event) => {
      if (event.target === menu || (event.target instanceof Element && event.target.closest("a"))) {
        closeMenu();
      }
    });

    // Escape closes the menu and returns focus to the toggle,
    // so focus never stays on a link that is no longer visible.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        closeMenu({ returnFocus: menu.contains(document.activeElement) });
      }
    });

    // Clicking or tabbing outside the navigation closes the menu.
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !navbar.contains(event.target)) {
        closeMenu();
      }
    });

    navbar.addEventListener("focusout", (event) => {
      const next = (event as FocusEvent).relatedTarget;

      if (next instanceof Node && !navbar.contains(next)) {
        closeMenu();
      }
    });
  });
</script>

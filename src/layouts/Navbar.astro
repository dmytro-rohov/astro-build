---
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import { t } from "@/i18n";

export type NavItem = {
  label: string;
  href: string;
  external?: boolean;
};

export type NavAction = {
  label: string;
  href: string;
  external?: boolean;
};

export interface Props {
  items: NavItem[];
  cta?: NavAction;
  /** Phone and e-mail of the topbar: on phones the topbar is hidden and they appear in the menu. */
  contact?: { phone?: string; email?: string };
  /** Phone menu button: the word "Menu" with the icon, or the icon alone (v3.3). */
  menuButton?: "label" | "icon";
  /** v3.5 "split": the links in two lists, on both sides of the centered logo (wide screens). */
  split?: boolean;
  /** v3.5 "minimal": the full-screen menu on every screen; the button stays in the bar. */
  overlay?: boolean;
  label?: string;
  class?: string;
}

const {
  items,
  cta,
  contact,
  menuButton = "label",
  split = false,
  overlay = false,
  label = t.nav.label,
  class: className,
  ...restProps
} = Astro.props;

const currentPath = Astro.url.pathname;

function normalizePath(path: string) {
  if (path === "/") return "/";

  return path.replace(/\/$/, "");
}

/** "page" for the current page; v3.9 "true" for the page above it (the blog on one of its posts). */
function isActiveLink(href: string): "page" | "true" | undefined {
  if (href.startsWith("http")) return undefined;
  if (href.startsWith("#")) return undefined;
  // Section links (/#features) point inside a page, not to the current page itself.
  if (href.includes("#")) return undefined;

  const link = normalizePath(href);
  const current = normalizePath(currentPath);
  if (link === current) return "page";
  return link !== "/" && current.startsWith(`${link}/`) ? "true" : undefined;
}

// Split navbar: the first half of the links left of the logo, the rest and the button (the last
// item of the second list) right of it.
const lists = split && items.length > 1
  ? [items.slice(0, Math.ceil(items.length / 2)), items.slice(Math.ceil(items.length / 2))]
  : [items];
---

<nav
  {...restProps}
  class:list={[
    "navbar",
    overlay && "navbar--overlay",
    className,
  ]}
  aria-label={label}
  data-navbar
>
  {overlay && cta && (
    <Button
      href={cta.href}
      external={cta.external}
      size="sm"
      class="navbar__cta navbar__cta--bar"
    >
      {cta.label}
    </Button>
  )}

  <button
    class:list={["navbar__toggle", `navbar__toggle--${menuButton}`]}
    type="button"
    aria-expanded="false"
    aria-controls="navbar-menu"
    data-navbar-toggle
  >
    <span class:list={["navbar__toggle-text", menuButton === "icon" && "visually-hidden"]}>{t.nav.menu}</span>
    <span class="navbar__icon" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div class="navbar__menu" id="navbar-menu" data-navbar-menu>
    {lists.map((list, index) => (
      <ul class:list={["navbar__list", lists.length > 1 && (index === 0 ? "navbar__list--start" : "navbar__list--end")]}>
        {list.map((item) => (
          <li class="navbar__item">
            <Link
              href={item.href}
              external={item.external}
              variant="nav"
              class="navbar__link"
              aria-current={isActiveLink(item.href)}
            >
              {item.label}
            </Link>
          </li>
        ))}
        {split && cta && index === lists.length - 1 && (
          <li class="navbar__item navbar__item--cta">
            <Button href={cta.href} external={cta.external} size="sm" class="navbar__cta">
              {cta.label}
            </Button>
          </li>
        )}
      </ul>
    ))}

    {!split && cta && (
      <Button
        href={cta.href}
        external={cta.external}
        size="sm"
        class="navbar__cta"
      >
        {cta.label}
      </Button>
    )}

    {(contact?.phone || contact?.email) && (
      <ul class="navbar__contact" aria-label={t.sections.contactBar}>
        {contact.phone && <li><a class="navbar__contact-link" href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}>{contact.phone}</a></li>}
        {contact.email && <li><a class="navbar__contact-link" href={`mailto:${contact.email}`}>{contact.email}</a></li>}
      </ul>
    )}
  </div>
</nav>

<script>
  const navbars = document.querySelectorAll("[data-navbar]");

  navbars.forEach((navbar) => {
    const toggle = navbar.querySelector("[data-navbar-toggle]");
    const menu = navbar.querySelector("[data-navbar-menu]");

    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) {
      return;
    }

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    // v3.12: the phone menu covers the page: while it is open the page behind it (main, footer) is
    // inert, so a screen reader cannot wander into what is hidden under it (WCAG 2.4.3).
    const behind = () => [...document.querySelectorAll<HTMLElement>("main, body > footer, .site-footer")];
    const setBehindInert = (inert: boolean) => {
      for (const element of behind()) {
        element.inert = inert;
      }
    };

    const closeMenu = ({ returnFocus = false } = {}) => {
      if (!isOpen()) {
        return;
      }

      toggle.setAttribute("aria-expanded", "false");
      navbar.removeAttribute("data-open");
      setBehindInert(false);

      if (returnFocus) {
        toggle.focus();
      }
    };

    const openMenu = () => {
      toggle.setAttribute("aria-expanded", "true");
      navbar.setAttribute("data-open", "");
      // Only where the menu is a layer over the page (the toggle shows: phones, the overlay menu).
      setBehindInert(toggle.getClientRects().length > 0);
    };

    /**
     * v3.12: a section of this page chosen in the open menu: the menu closes, the page scrolls to the
     * section and focus moves to its heading (it would fall to the page's start with the hidden link).
     * Done here, not by the browser: its jump to a section that cannot take focus clears the focus.
     * Returns false for any other link (it works as usual).
     */
    const goToSection = (link: HTMLAnchorElement) => {
      if (!link.hash || link.origin !== location.origin || link.pathname !== location.pathname) {
        return false;
      }

      const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      const heading = section?.querySelector<HTMLElement>("h1, h2, h3") ?? section;

      if (!section || !heading) {
        return false;
      }

      if (!heading.hasAttribute("tabindex")) {
        heading.setAttribute("tabindex", "-1");
      }

      history.pushState(null, "", link.hash);
      // Smooth or not as the page scrolls (reduced motion: at once); below the sticky header (scroll-padding-top).
      section.scrollIntoView({ block: "start" });
      heading.focus({ preventScroll: true });
      return true;
    };

    toggle.addEventListener("click", () => {
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // A link, or the empty part of the full-screen phone menu, closes it.
    menu.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a") : null;

      if (event.target === menu || link) {
        const wasOpen = isOpen();
        closeMenu();

        if (wasOpen && link && goToSection(link)) {
          event.preventDefault();
        }
      }
    });

    // Escape closes the menu and returns focus to the toggle,
    // so focus never stays on a link that is no longer visible.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        closeMenu({ returnFocus: menu.contains(document.activeElement) });
      }
    });

    // Clicking or tabbing outside the navigation closes the menu.
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !navbar.contains(event.target)) {
        closeMenu();
      }
    });

    // Grown out of the phone layout while open (rotation, zoom out): the menu is a plain row again.
    window.addEventListener("resize", () => {
      if (isOpen() && toggle.getClientRects().length === 0) {
        closeMenu();
      }
    }, { passive: true });

    navbar.addEventListener("focusout", (event) => {
      const next = (event as FocusEvent).relatedTarget;

      if (next instanceof Node && !navbar.contains(next)) {
        closeMenu();
      }
    });
  });
</script>

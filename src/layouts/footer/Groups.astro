---
/**
 * Link groups, each its own navigation labelled by its title. v3.12: the title is no heading (a few more h2 on every
 * page would only blur the page's outline); `aria-labelledby` still names the navigation.
 */
import Link from "@/components/ui/Link.astro";
import type { FooterLinkGroup } from "./types";

export interface Props {
  groups: FooterLinkGroup[];
  class?: string;
}

const { groups, class: className } = Astro.props;
---

{groups.map((group, index) => (
  <nav class:list={["site-footer__group", className]} aria-labelledby={`footer-group-${index + 1}`}>
    <p id={`footer-group-${index + 1}`} class="site-footer__group-title">{group.title}</p>
    <ul class="site-footer__link-list">
      {group.links.map((link) => (
        <li>
          <Link href={link.href} external={link.external} variant="muted" class="site-footer__link">{link.label}</Link>
        </li>
      ))}
    </ul>
  </nav>
))}

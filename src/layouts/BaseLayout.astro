---
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import { siteConfig } from "@/config/site";
import { isNoindexPath } from "@/config/indexing";
import { dir, ogLocale, pageTitle, t } from "@/i18n";
import { tokens } from "@/design-system/tokens";
import { semanticColorsDark } from "@/design-system/tokens/semantic/color-semantic";
import { fontPreloads } from "@/design-system/fonts.generated";
import { hasSvgFavicon } from "@/design-system/appIcons.generated";
import {
  breadcrumbSchema,
  organizationSchema,
  schemaGraph,
  serializeJsonLd,
  webPageSchema,
  websiteSchema,
  type BreadcrumbItem,
} from "@/lib/seo/schema";
import "@/styles/main.scss";

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  pageType?: "website" | "profile";
  /**
   * Extra schema.org nodes for this page (e.g. Service, Product, Event).
   * Organization, WebSite, WebPage and BreadcrumbList are added automatically.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Breadcrumb trail for structured data. Defaults to Home › page title
   * on subpages. Pass `false` to leave it out.
   */
  breadcrumbs?: BreadcrumbItem[] | false;
  showHeader?: boolean;
  showFooter?: boolean;
  keywords?: string;
  author?: string;
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.seo.image,
  imageAlt = siteConfig.seo.imageAlt,
  canonicalPath = Astro.url.pathname,
  robots: robotsProp = "index, follow",
  pageType = "website",
  jsonLd,
  breadcrumbs,
  showHeader = true,
  showFooter = true,
  keywords = siteConfig.keywords.join(", "),
  author = siteConfig.author,
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const ogType = pageType === "profile" ? "profile" : "website";

const fullTitle = pageTitle(title);
const robots = isNoindexPath(Astro.url.pathname) ? "noindex, follow" : robotsProp;
const lang = siteConfig.lang;
const isDefaultImage = image === siteConfig.seo.image;

// Structured data: one @graph per page.
const isHome = canonicalUrl.pathname === "/";
const isIndexable = !robots.includes("noindex");
const breadcrumbItems: BreadcrumbItem[] | false =
  breadcrumbs ?? (isHome ? false : [
    { name: t.nav.home, path: "/" },
    { name: title ?? siteConfig.name, path: canonicalUrl.pathname },
  ]);
const breadcrumbNode = isIndexable && breadcrumbItems
  ? breadcrumbSchema(breadcrumbItems, canonicalUrl.toString(), siteUrl)
  : undefined;
const extraNodes = jsonLd ? [jsonLd].flat() : [];

const structuredData = schemaGraph([
  organizationSchema(siteUrl),
  websiteSchema(siteUrl),
  ...(isIndexable
    ? [webPageSchema({
        url: canonicalUrl.toString(),
        title: fullTitle,
        description,
        image: socialImageUrl.toString(),
        siteUrl,
        breadcrumbId: breadcrumbNode?.["@id"] as string | undefined,
      })]
    : []),
  ...(breadcrumbNode ? [breadcrumbNode] : []),
  ...extraNodes,
]);

const { colorScheme } = siteConfig;
const dataTheme = colorScheme === "auto" ? undefined : colorScheme;
const colorSchemeMeta = colorScheme === "auto" ? "light dark" : colorScheme;

---

<!doctype html>
<html lang={lang} dir={dir} data-theme={dataTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    {author && <meta name="author" content={author} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="color-scheme" content={colorSchemeMeta} />
    {colorScheme === "auto" ? (
      <>
        <meta name="theme-color" media="(prefers-color-scheme: light)" content={tokens.color.action.primary} />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content={semanticColorsDark.action.primary} />
      </>
    ) : (
      <meta name="theme-color" content={colorScheme === "dark" ? semanticColorsDark.action.primary : tokens.color.action.primary} />
    )}
    
    {isIndexable && <link rel="canonical" href={canonicalUrl.toString()} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {hasSvgFavicon
      ? <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      : <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />}
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {fontPreloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}/>
    <meta property="og:site_name" content={siteConfig.name}/>
    <meta property="og:title" content={fullTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalUrl}/>
    <meta property="og:image" content={socialImageUrl}/>
    <meta property="og:image:alt" content={imageAlt}/>
    {isDefaultImage && (
      <>
        <meta property="og:image:width" content={String(siteConfig.seo.imageWidth)}/>
        <meta property="og:image:height" content={String(siteConfig.seo.imageHeight)}/>
        <meta property="og:image:type" content="image/jpeg"/>
      </>
    )}
    <meta property="og:locale" content={ogLocale}/>

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={fullTitle}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={socialImageUrl}/>
    <meta name="twitter:image:alt" content={imageAlt}/>

    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(structuredData)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">{t.common.skipToContent}</a>
    {showHeader && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {showFooter && <Footer />}
    <CookieConsent />
    <script>
      import "@scripts/reveal";
    </script>
  </body>
</html>
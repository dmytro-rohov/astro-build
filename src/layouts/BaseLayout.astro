---
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import Counters from "@/components/widgets/Counters.astro";
import { siteConfig } from "@/config/site";
import { isNoindexPath, NOINDEX_ROBOTS } from "@/config/indexing";
import { dir, format, ogLocale, pageTitle, t } from "@/i18n";
import { siteTheme } from "@/site/theme";
import { fontPreloads } from "@/design-system/fonts.generated";
import { brandLogo, hasSvgFavicon, ogCover } from "@/design-system/appIcons.generated";
import { EditorBridge, editorOrigin } from "virtual:editor-bridge";
import { site, noindex as siteNoindex } from "virtual:site";
import { getImage } from "astro:assets";
import { getAsset } from "@/site/assets";
import { ogImageOf } from "@/site/og";
import { FACTORY_URL, GENERATOR, WORDMARK, sourceComment } from "@/site/signature";
import { verificationTags } from "@/site/seo";
import {
  breadcrumbSchema,
  ownerSchema,
  schemaGraph,
  serializeJsonLd,
  webPageSchema,
  websiteSchema,
  type BreadcrumbItem,
} from "@/lib/seo/schema";
import "@/styles/main.scss";
// v3.5: the navbar variant's own styles, after main.scss (they refine the shared header).
import "virtual:navbar-style";

export interface Props {
  title?: string;
  /** Use `title` as is, without the "{title} | {site name}" template (home page). */
  titleIsFull?: boolean;
  /** v3.12: the page's own title for search results and sharing (seo.title), used as is in <title> and og:title. */
  seoTitle?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  pageType?: "website" | "profile" | "article";
  /** v3.9: a blog post's dates, category and tags (og:type article). */
  article?: { published: string; modified?: string; section?: string; tags: string[] };
  /**
   * Extra schema.org nodes for this page (e.g. Service, Product, Event).
   * Organization, WebSite, WebPage and BreadcrumbList are added automatically.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Breadcrumb trail for structured data. Defaults to Home › page title
   * on subpages. Pass `false` to leave it out.
   */
  breadcrumbs?: BreadcrumbItem[] | false;
  showHeader?: boolean;
  showFooter?: boolean;
  keywords?: string;
  author?: string;
}

const {
  title,
  titleIsFull = false,
  seoTitle,
  description = siteConfig.description,
  image: imageProp,
  imageAlt = siteConfig.seo.imageAlt,
  canonicalPath = Astro.url.pathname,
  robots: robotsProp = "index, follow",
  pageType = "website",
  article,
  jsonLd,
  breadcrumbs,
  showHeader = true,
  showFooter = true,
  keywords = siteConfig.keywords.join(", "),
  author = siteConfig.author,
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url.origin;
// The site's own sharing image (meta.seo.image cropped, else /og-cover.jpg): also on the engine's pages.
const siteImage = await ogImageOf();
const image = imageProp ?? siteImage;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const ogType = pageType;
// v3.9: the blog's feed, announced on every page of a site with posts.
const hasFeed = Boolean(siteConfig.blogFeed);

const fullTitle = seoTitle ?? (titleIsFull && title ? title : pageTitle(title));
// v3.12: a SITE_NOINDEX build (the factory's previews) hides every page, whatever the page asks for.
const robots = siteNoindex ? NOINDEX_ROBOTS : isNoindexPath(Astro.url.pathname) ? "noindex, follow" : robotsProp;
const lang = siteConfig.lang;
// Every Open Graph image is 1200×630 (generated or cropped at build time).
const isDefaultImage = true;

// Structured data: one @graph per page.
const isHome = canonicalUrl.pathname === "/";
const isIndexable = !robots.includes("noindex");
const breadcrumbItems: BreadcrumbItem[] | false =
  breadcrumbs ?? (isHome ? false : [
    { name: t.nav.home, path: "/" },
    { name: title ?? siteConfig.name, path: canonicalUrl.pathname },
  ]);
const breadcrumbNode = isIndexable && breadcrumbItems
  ? breadcrumbSchema(breadcrumbItems, canonicalUrl.toString(), siteUrl)
  : undefined;
const extraNodes = jsonLd ? [jsonLd].flat() : [];

// v3.12: the owner's logo (none for a monogram), a photo of the business (not the text card) and the person's portrait
// (a personal site's blog author photo).
const authorPhoto = site.business.kind === "personal" ? site.blog?.author?.photo : undefined;
const portrait = authorPhoto
  ? (await getImage({ src: getAsset(authorPhoto).image, width: 400, height: 400, fit: "cover", format: "jpg" })).src
  : undefined;
const absoluteUrl = (path?: string | null) => (path ? new URL(path, siteUrl).toString() : undefined);

const structuredData = schemaGraph([
  ...ownerSchema({
    siteUrl,
    logo: absoluteUrl(brandLogo),
    image: site.meta.seo.image || ogCover === "photo" ? absoluteUrl(siteImage) : undefined,
    portrait: absoluteUrl(portrait),
  }),
  websiteSchema(siteUrl),
  ...(isIndexable
    ? [webPageSchema({
        url: canonicalUrl.toString(),
        title: fullTitle,
        description,
        image: socialImageUrl.toString(),
        siteUrl,
        breadcrumbId: breadcrumbNode?.["@id"] as string | undefined,
      })]
    : []),
  ...(breadcrumbNode ? [breadcrumbNode] : []),
  ...extraNodes,
]);

const { colorScheme } = siteConfig;
const dataTheme = colorScheme === "auto" ? undefined : colorScheme;
const colorSchemeMeta = colorScheme === "auto" ? "light dark" : colorScheme;

---

<!doctype html>
<html lang={lang} dir={dir} data-theme={dataTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={sourceComment(t.signature, siteConfig.name)} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={GENERATOR} />
    {/* v3.12: the webmaster tools' site verification; none in a SITE_NOINDEX build. */}
    {!siteNoindex && verificationTags(site.meta.verification).map(([name, content]) => <meta name={name} content={content} />)}
    {author && <meta name="author" content={author} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="color-scheme" content={colorSchemeMeta} />
    {colorScheme === "auto" ? (
      <>
        <meta name="theme-color" media="(prefers-color-scheme: light)" content={siteTheme.light.action.primary} />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content={siteTheme.dark.action.primary} />
      </>
    ) : (
      <meta name="theme-color" content={colorScheme === "dark" ? siteTheme.dark.action.primary : siteTheme.light.action.primary} />
    )}
    
    {isIndexable && <link rel="canonical" href={canonicalUrl.toString()} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {hasSvgFavicon
      ? <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      : <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />}
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" type="text/plain" />
    {hasFeed && <link rel="alternate" type="application/rss+xml" title={siteConfig.blogFeed} href="/rss.xml" />}
    {fontPreloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}/>
    <meta property="og:site_name" content={siteConfig.name}/>
    <meta property="og:title" content={fullTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalUrl}/>
    <meta property="og:image" content={socialImageUrl}/>
    <meta property="og:image:alt" content={imageAlt}/>
    {isDefaultImage && (
      <>
        <meta property="og:image:width" content={String(siteConfig.seo.imageWidth)}/>
        <meta property="og:image:height" content={String(siteConfig.seo.imageHeight)}/>
        <meta property="og:image:type" content="image/jpeg"/>
      </>
    )}
    <meta property="og:locale" content={ogLocale}/>
    {article && (
      <>
        <meta property="article:published_time" content={article.published}/>
        {article.modified && <meta property="article:modified_time" content={article.modified}/>}
        {article.section && <meta property="article:section" content={article.section}/>}
        {article.tags.map((tag) => <meta property="article:tag" content={tag}/>)}
      </>
    )}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={fullTitle}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={socialImageUrl}/>
    <meta name="twitter:image:alt" content={imageAlt}/>

    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(structuredData)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">{t.common.skipToContent}</a>
    {showHeader && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {showFooter && <Footer />}
    <CookieConsent />
    <Counters />
    <span
      hidden
      data-signature
      data-art={WORDMARK}
      data-text={format(t.signature.console, { url: FACTORY_URL })}
      data-hint={t.signature.consoleHint}
    ></span>
    {EditorBridge && <EditorBridge origin={editorOrigin} />}
    <script>
      // The sticky header's real height: the hero fills the rest of the first screen (--header-offset)
      // and the phone menu opens right under the header.
      // A constructed style sheet, not a style="" attribute: inline styles are blocked by the CSP.
      const header = document.querySelector(".site-header");
      const sheet = new CSSStyleSheet();
      document.adoptedStyleSheets = [...document.adoptedStyleSheets, sheet];
      const setOffset = () => sheet.replaceSync(`:root { --header-offset: ${header instanceof HTMLElement ? header.offsetHeight : 0}px; }`);
      setOffset();
      window.addEventListener("resize", setOffset, { passive: true });

      // v3.7 easter egg for the curious who open the console (src/site/signature.ts): the wordmark,
      // who built the site and the way to the next secret, /humans.txt — in the site's language.
      const signature = document.querySelector<HTMLElement>("[data-signature]");
      if (signature) {
        const { art = "", text = "", hint = "" } = signature.dataset;
        console.info(
          `%c${art}%c\n\n${text}\n%c${hint.replace("{url}", new URL("/humans.txt", location.href).href)}`,
          "display:inline-block;padding:10px 14px;border-radius:8px;background:#0b110d;color:#c6f04f;font-family:ui-monospace,monospace;line-height:1.2",
          "color:inherit;font-weight:600",
          "color:#8a9a7a;font-style:italic",
        );
      }
    </script>
  </body>
</html>
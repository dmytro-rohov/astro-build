---
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Cluster from "@/components/layouts/Cluster.astro";
import Link from "@/components/ui/Link.astro";
import Divider from "@/components/ui/Divider.astro";
import Icon from "@/components/media/Icon.astro";
import { siteConfig } from "@/config/site";
import Logo from "@/components/media/Logo.astro";
import { ANALYTICS_CONFIG } from "@/config/analytics";
import { format, t } from "@/i18n";
import { site } from "virtual:site";

export type FooterLink = {
  label: string;
  href: string;
  external?: boolean;
  analyticsLabel?: string;
};

export type FooterLinkGroup = {
  title: string;
  links: FooterLink[];
};

export type SocialLink = {
  label: string;
  href: string;
  icon: string;
};

export interface Props {
  brandLabel?: string;
  brandHref?: string;
  description?: string;
  groups?: FooterLinkGroup[];
  socialLinks?: SocialLink[];
  phone?: string;
  phoneHref?: string;
  email?: string;
  copyright?: string;
  class?: string;
}

const year = new Date().getFullYear();

const {
  brandLabel = siteConfig.name,
  brandHref = "/",
  description = siteConfig.footer.description,
  groups = siteConfig.footer.groups,
  socialLinks = siteConfig.footer.socialLinks,
  phone = siteConfig.organization.phone,
  phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined,
  email = siteConfig.organization.email,
  copyright = format(t.footer.copyright, { year, siteName: brandLabel }),
  class: className,
  ...restProps
} = Astro.props;

const variant = site.layout.footer.variant;
const allLinks = groups.flatMap((group) => group.links);
---

<footer
  {...restProps}
  class:list={[
    "site-footer",
    `site-footer--${variant}`,
    className,
  ]}
>
  <Container size="xl">
    <Stack space="xl">
      {variant !== "columns" && (
        <div class="site-footer__compact">
          <a class="site-footer__brand" href={brandHref}>
            <Logo size="footer" />
          </a>
          {variant === "centered" && description && <p class="site-footer__description">{description}</p>}
          {socialLinks.length > 0 && (
            <ul class="site-footer__social-list site-footer__social-list--inline">
              {socialLinks.map((item) => (
                <li class="site-footer__social-item">
                  <a class="site-footer__social-link" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
                    <Icon name={item.icon} />
                  </a>
                </li>
              ))}
            </ul>
          )}
          <nav aria-label={brandLabel} class="site-footer__inline-nav">
            <ul class="site-footer__inline-links">
              {allLinks.map((link) => (
                <li><Link href={link.href} external={link.external} variant="muted" class="site-footer__link">{link.label}</Link></li>
              ))}
            </ul>
          </nav>
        </div>
      )}
      {variant === "columns" && (
      <div class="site-footer__main">
        <Stack class="site-footer__brand-block" space="md">
          <a class="site-footer__brand" href={brandHref}>
            <Logo size="footer" />
          </a>

          {description && (
            <p class="site-footer__description">
              {description}
            </p>
          )}

          {(phone || email) && (
            <ul class="site-footer__contact">
              {phone && (
                <li class="site-footer__contact-item">
                  <Icon name="phone" />
                  <Link href={phoneHref ?? `tel:${phone}`} variant="muted">{phone}</Link>
                </li>
              )}
              {email && (
                <li class="site-footer__contact-item">
                  <Icon name="mail" />
                  <Link href={`mailto:${email}`} variant="muted">{email}</Link>
                </li>
              )}
            </ul>
          )}

          {socialLinks.length > 0 && (
            <Cluster as="ul" gap="sm" class="site-footer__social-list">
              {socialLinks.map((item) => (
                <li class="site-footer__social-item">
                  <a
                    class="site-footer__social-link"
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={item.label}
                  >
                    <Icon name={item.icon} />
                  </a>
                </li>
              ))}
            </Cluster>
          )}
        </Stack>

        {groups.length > 0 && (
          <div class="site-footer__groups">
            {groups.map((group) => (
              <nav class="site-footer__group" aria-label={group.title}>
                <h2 class="site-footer__group-title">
                  {group.title}
                </h2>

                <ul class="site-footer__link-list">
                  {group.links.map((link) => (
                    <li>
                      <Link
                        href={link.href}
                        external={link.external}
                        variant="muted"
                        class="site-footer__link"
                      >
                        {link.label}
                      </Link>
                    </li>
                  ))}
                </ul>
              </nav>
            ))}
          </div>
        )}
      </div>
      )}

      <Divider />

      <div class="site-footer__bottom">
        <p class="site-footer__copyright">
          {copyright}
        </p>

        {ANALYTICS_CONFIG.enabled && (
          <button
            type="button"
            class="site-footer__cookie-settings"
            data-cookie-settings
          >
            {t.footer.cookieSettings}
          </button>
        )}
      </div>
    </Stack>
  </Container>
</footer>
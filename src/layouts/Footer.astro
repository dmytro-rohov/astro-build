---
/**
 * Site footer: the shell every variant shares (tone, container, copyright row). The body comes
 * from the component of the site's variant (src/layouts/footer/, "virtual:layout-components"),
 * which brings only its own styles.
 */
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Link from "@/components/ui/Link.astro";
import Divider from "@/components/ui/Divider.astro";
import FactoryCredit from "@/components/FactoryCredit.astro";
import { siteConfig } from "@/config/site";
import { ANALYTICS_CONFIG } from "@/config/analytics";
import { format, t } from "@/i18n";
import type { FooterLinkGroup, SocialLink } from "@/layouts/footer/types";
import { site } from "virtual:site";
import { layoutComponents } from "virtual:layout-components";

export type { FooterLink, FooterLinkGroup, SocialLink } from "@/layouts/footer/types";

export interface Props {
  brandLabel?: string;
  brandHref?: string;
  description?: string;
  groups?: FooterLinkGroup[];
  socialLinks?: SocialLink[];
  phone?: string;
  phoneHref?: string;
  email?: string;
  copyright?: string;
  class?: string;
}

const year = new Date().getFullYear();

const {
  brandLabel = siteConfig.name,
  brandHref = "/",
  description = siteConfig.footer.description,
  groups = siteConfig.footer.groups,
  socialLinks = siteConfig.footer.socialLinks,
  phone = siteConfig.organization.phone,
  phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined,
  email = siteConfig.organization.email,
  copyright = format(t.footer.copyright, { year, siteName: brandLabel }),
  class: className,
  ...restProps
} = Astro.props;

const { variant, props } = site.layout.footer;
const Variant = layoutComponents.footer;
const businessAddress = site.business.address;
const address = [businessAddress?.street, [businessAddress?.postalCode, businessAddress?.city].filter(Boolean).join(" ")]
  .filter(Boolean)
  .join(", ");

// v3.5: "auto" is the site's colors; the rounded card is dark unless the site picks a tone.
const tone = props.tone && props.tone !== "auto" ? props.tone : variant === "rounded-card" ? "dark" : "auto";

// The newer layouts keep the privacy link in the bottom row, so the link groups leave it out.
const privacyHref = "/privacy";
const legalInBottom = !["columns", "simple", "centered"].includes(variant);
const linkGroups = legalInBottom
  ? groups.map((group) => ({ ...group, links: group.links.filter((link) => link.href !== privacyHref) })).filter((group) => group.links.length > 0)
  : groups;
---

<footer
  {...restProps}
  class:list={[
    "site-footer",
    `site-footer--${variant}`,
    tone !== "auto" && `site-footer--tone-${tone}`,
    className,
  ]}
>
  <Container size="xl">
    <Stack space="xl">
      <Variant
        brandLabel={brandLabel}
        brandHref={brandHref}
        description={description}
        groups={linkGroups}
        socialLinks={socialLinks}
        contact={{ address, phone, phoneHref, email }}
      />

      <Divider />

      <div class="site-footer__bottom">
        <p class="site-footer__copyright">
          {copyright}
        </p>

        {legalInBottom && (
          <nav class="site-footer__legal" aria-label={t.footer.legal}>
            <Link href={privacyHref} variant="muted" class="site-footer__link">{t.footer.privacyPolicy}</Link>
            {ANALYTICS_CONFIG.enabled && (
              <button type="button" class="site-footer__cookie-settings" data-cookie-settings>{t.footer.cookieSettings}</button>
            )}
          </nav>
        )}

        <FactoryCredit />

        {!legalInBottom && ANALYTICS_CONFIG.enabled && (
          <button
            type="button"
            class="site-footer__cookie-settings"
            data-cookie-settings
          >
            {t.footer.cookieSettings}
          </button>
        )}
      </div>
    </Stack>
  </Container>
</footer>

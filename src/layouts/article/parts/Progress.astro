---
/**
 * v3.9: a thin reading progress bar at the very top of the screen. A native <progress> whose value
 * the script sets (no style attribute: the CSP blocks inline styles); hidden from screen readers.
 */
import { t } from "@/i18n";
---

<progress class="article-progress" max="100" value="0" aria-hidden="true" title={t.blog.progress} data-article-progress></progress>

<script>
  const bar = document.querySelector<HTMLProgressElement>("[data-article-progress]");
  const body = document.querySelector<HTMLElement>("[data-article-body]");

  if (bar && body) {
    let frame = 0;
    const update = () => {
      const box = body.getBoundingClientRect();
      const total = box.height - window.innerHeight * 0.6;
      bar.value = total > 0 ? Math.min(100, Math.max(0, (-box.top / total) * 100)) : 100;
    };
    window.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    }, { passive: true });
    update();
  }
</script>

---
/**
 * v3.9: a post's blocks as HTML. Text is rendered and escaped by the engine (richtext-lite), headings
 * get the chapter ids of the table of contents, galleries open in the lightbox, videos load only
 * after a click. `skipPhotos`: the photo layout shows the photos beside the text already.
 */
import Button from "@/components/ui/Button.astro";
import Img from "@/components/media/Img.astro";
import Lightbox from "@/components/widgets/Lightbox.astro";
import EmbedFrame from "@/sections/_shared/EmbedFrame.astro";
import Photo from "@/sections/gallery/Photo.astro";
import { format, t } from "@/i18n";
import { getAsset } from "@/site/assets";
import { renderRichTextInline, renderRichTextLite } from "@/site/richtext";
import type { Article } from "@/layouts/article/data";
import "@/styles/sections/gallery/_shared.scss";
import "@/styles/layouts/article/_prose.scss";

export interface Props {
  article: Article;
  skipPhotos?: boolean;
  /** Editorial touches: a drop cap on the first paragraph, quotes pulled into the margin. */
  editorial?: boolean;
  class?: string;
}

const { article, skipPhotos = false, editorial = false, class: className } = Astro.props;
const ids = new Map(article.chapters.map((chapter) => [chapter.block, chapter.id]));
const blocks = article.post.body
  .map((block, index) => ({ block, index }))
  .filter(({ block }) => !(skipPhotos && (block.type === "image" || block.type === "gallery")));
---

<div class:list={["prose", editorial && "prose--editorial", className]} data-article-body>
  {blocks.map(({ block, index }) => {
    switch (block.type) {
      case "paragraph":
        return <Fragment set:html={renderRichTextLite(block.text, { newTab: t.common.newTab })} />;
      case "heading": {
        const Heading = block.level === 3 ? "h3" : "h2";
        return <Heading id={ids.get(index)} class="prose__heading">{block.text}</Heading>;
      }
      case "list": {
        const List = block.ordered ? "ol" : "ul";
        return <List class="prose__list">{block.items.map((item) => <li set:html={renderRichTextInline(item, { newTab: t.common.newTab })} />)}</List>;
      }
      case "quote":
        return (
          <figure class="prose__quote">
            <blockquote><p>{block.text}</p></blockquote>
            {block.cite && <figcaption>{block.cite}</figcaption>}
          </figure>
        );
      case "image": {
        const photo = getAsset(block.image);
        return (
          <figure class:list={["prose__figure", block.wide && "prose__figure--wide"]}>
            <Img
              src={photo.image}
              alt={photo.alt}
              kind={photo.alt ? "content" : "decorative"}
              focal={photo.focal}
              widths={[480, 768, 1080, 1440]}
              sizes={block.wide ? "(min-width: 1280px) 1120px, 100vw" : "(min-width: 768px) 720px, 100vw"}
              class="prose__image"
            />
            {block.caption && <figcaption>{block.caption}</figcaption>}
          </figure>
        );
      }
      case "gallery":
        return (
          <figure class="prose__gallery">
            <Lightbox label={block.caption ?? t.blog.photos}>
              <ul class:list={["prose__tiles", block.images.length % 3 === 0 || block.images.length > 4 ? "prose__tiles--3" : "prose__tiles--2"]}>
                {block.images.map((image, number) => (
                  <li>
                    <Photo
                      image={image}
                      lightbox={true}
                      aspect={[1, 1]}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 768px) 240px, 50vw"
                      label={format(t.lightbox.status, { number: number + 1, count: block.images.length })}
                    />
                  </li>
                ))}
              </ul>
            </Lightbox>
            {block.caption && <figcaption>{block.caption}</figcaption>}
          </figure>
        );
      case "video":
        return <EmbedFrame url={block.url} title={block.title} class="prose__video" />;
      case "callout":
        return (
          <aside class="prose__callout">
            {block.title && <p class="prose__callout-title">{block.title}</p>}
            <div set:html={renderRichTextLite(block.text, { newTab: t.common.newTab })} />
          </aside>
        );
      case "cta":
        return (
          <div class="prose__cta">
            {block.title && <p class="prose__cta-title">{block.title}</p>}
            {block.text && <p class="prose__cta-text">{block.text}</p>}
            <Button href={block.action.href}>{block.action.label}</Button>
          </div>
        );
      default:
        return null;
    }
  })}
</div>

---
/**
 * v3.9: the author (small photo and name, else the business) and the update date when there is one
 * (v3.12: in a <time> with the machine-readable date, the words around it from the dictionary).
 */
import { site } from "virtual:site";
import Img from "@/components/media/Img.astro";
import { postDate } from "@/components/blog/data";
import { t } from "@/i18n";
import { getAsset } from "@/site/assets";
import type { Article } from "@/layouts/article/data";

export interface Props {
  article: Article;
}

const { article } = Astro.props;
const name = article.author?.name ?? site.business.name ?? site.meta.name;
const photo = article.author?.photo ? getAsset(article.author.photo) : undefined;
const updated = article.post.updated && article.post.updated !== article.post.date ? article.post.updated : undefined;
const [updatedBefore, updatedAfter = ""] = t.blog.updated.split("{date}");
---

<p class="article-byline">
  {photo && <Img src={photo.image} alt="" kind="decorative" aspect={[1, 1]} focal={photo.focal} widths={[80]} sizes="40px" class="article-byline__photo" />}
  <span class="article-byline__text">
    <span class="article-byline__name">{name}</span>
    {updated && <span class="article-byline__updated">{updatedBefore}<time datetime={updated}>{postDate(updated)}</time>{updatedAfter}</span>}
  </span>
</p>

---
/** v3.9 posts "featured": the newest post large (cover beside the text), the others as cards below. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Stack from "@/components/layouts/Stack.astro";
import Icon from "@/components/media/Icon.astro";
import PostCover from "@/components/blog/PostCover.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import PostsFrame from "@/components/blog/PostsFrame.astro";
import { postUrl } from "@/components/blog/data";
import { postsList } from "@/sections/posts/list";
import { t } from "@/i18n";
import type { VariantOf } from "@/site/types";
import "@/styles/blog/_card.scss";
import "@/styles/sections/posts/_featured.scss";

export interface Props {
  section: VariantOf<"posts", "featured">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
// The big first post has to stay first: no category buttons here.
const { posts, perPage, itemHeading: Title } = postsList(section, headingLevel, { filter: false });
const align = props.align ?? "left";
---

<SectionShell id={section.id} type="posts" variant="featured" tone={props.tone} spacing={props.spacing} width="xl">
  <Stack space="xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={align} />
    <PostsFrame count={posts.length} categories={[]} perPage={perPage} link={content.link} align={align}>
      <ul class="s-posts-featured">
        {posts.map((post, index) => (
          <li data-post class:list={[index === 0 && "s-posts-featured__lead"]}>
            <article class="post-card">
              <div class="post-card__media">
                <PostCover
                  post={post}
                  aspect={index === 0 ? [16, 10] : [3, 2]}
                  widths={index === 0 ? [640, 960, 1280] : [400, 640, 960]}
                  sizes={index === 0 ? "(min-width: 1024px) 720px, 100vw" : "(min-width: 1280px) 400px, (min-width: 640px) 50vw, 100vw"}
                />
              </div>
              <div class="post-card__text">
                <PostMeta post={post} />
                <Title class="post-card__title"><a class="post-card__link" href={postUrl(post)}>{post.title}</a></Title>
                <p class="post-card__excerpt">{post.excerpt}</p>
                {index === 0 && <span class="post-card__more" aria-hidden="true">{t.blog.readMore}<Icon name="arrow-right" size="1em" /></span>}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </PostsFrame>
  </Stack>
</SectionShell>

---
/** v3.9 posts "minimal": a typographic list without photos: date and category, a large title, a line between posts. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Stack from "@/components/layouts/Stack.astro";
import Icon from "@/components/media/Icon.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import PostsFrame from "@/components/blog/PostsFrame.astro";
import { postUrl } from "@/components/blog/data";
import { postsList } from "@/sections/posts/list";
import type { VariantOf } from "@/site/types";
import "@/styles/blog/_card.scss";
import "@/styles/sections/posts/_minimal.scss";

export interface Props {
  section: VariantOf<"posts", "minimal">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const { posts, categories, perPage, itemHeading: Title } = postsList(section, headingLevel);
const align = props.align ?? "left";
---

<SectionShell id={section.id} type="posts" variant="minimal" tone={props.tone} spacing={props.spacing}>
  <Stack space="xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={align} />
    <PostsFrame count={posts.length} categories={categories} perPage={perPage} link={content.link} align={align}>
      <ul class="s-posts-minimal">
        {posts.map((post) => (
          <li data-post data-post-category={post.category}>
            <article class="post-card s-posts-minimal__row">
              <PostMeta post={post} dateStyle="medium" class="s-posts-minimal__meta" />
              <div class="s-posts-minimal__text">
                <Title class="post-card__title"><a class="post-card__link" href={postUrl(post)}>{post.title}</a></Title>
                <p class="post-card__excerpt">{post.excerpt}</p>
              </div>
              <Icon name="arrow-right" size="1.5rem" class="s-posts-minimal__arrow" />
            </article>
          </li>
        ))}
      </ul>
    </PostsFrame>
  </Stack>
</SectionShell>

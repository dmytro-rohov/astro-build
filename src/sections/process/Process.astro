---
/**
 * The process variants built from one markup (the CSS lays it out):
 * "steps" (icons and big numbers on one connecting line), "timeline" (cards alternating
 * around a central line) and "cards" (cards with outlined numbers and connectors).
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Stack from "@/components/layouts/Stack.astro";
import Icon from "@/components/media/Icon.astro";
import { listClasses, stepNumber } from "@/sections/process/layout";
import type { SectionOf } from "@/site/types";

export interface Props {
  section: SectionOf<"process">;
  headingLevel: "h1" | "h2";
  variant: "steps" | "timeline" | "cards";
}

const { section, headingLevel, variant } = Astro.props;
const { content, props } = section;
const StepHeading = headingLevel === "h1" ? "h2" : "h3";
---

<SectionShell id={section.id} type="process" variant={variant} tone={props.tone} spacing={props.spacing} width={variant === "timeline" ? "md" : "lg"}>
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <ol class:list={listClasses(variant, content.steps.length, variant === "timeline" ? undefined : 4)}>
      {content.steps.map((step, index) => (
        <li class="s-process__step">
          {/* Icon (a dot without one) and the big number; the timeline puts them on both sides of its line. */}
          <span class="s-process__marker" aria-hidden="true">
            <span class:list={["s-process__icon", !step.icon && "s-process__icon--dot"]}>
              {step.icon && <Icon name={step.icon} size="1.5rem" />}
            </span>
            <span class="s-process__index">{stepNumber(index)}</span>
          </span>
          <div class="s-process__body">
            {step.duration && <p class="s-process__duration">{step.duration}</p>}
            <StepHeading class="s-process__title">{step.title}</StepHeading>
            <p class="s-process__description">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </Stack>
</SectionShell>

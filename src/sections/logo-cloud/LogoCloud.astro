---
/**
 * The first two logo-cloud variants: "row" (muted logos) and "grid" (own colors on equal tiles).
 * v3.3: logos sized by their proportions (Logo.astro) in balanced rows — never 5 + 1.
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Logo from "@/sections/logo-cloud/Logo.astro";
import Stack from "@/components/layouts/Stack.astro";
import { logoRows } from "@/sections/logo-cloud/layout";
import type { SectionOf } from "@/site/types";

export interface Props {
  section: SectionOf<"logo-cloud">;
  headingLevel: "h1" | "h2";
  variant: "row" | "grid";
}

const { section, headingLevel, variant } = Astro.props;
const { content, props } = section;
const count = content.items.length;
// Tiles: two per row on phones, at most four up to eight logos (big tiles), six for more.
const rows = variant === "grid" ? logoRows(count, [2, 3, count <= 8 ? 4 : 6]) : logoRows(count, [3, 4, 6]);
---

<SectionShell id={section.id} type="logo-cloud" variant={variant} tone={props.tone} spacing={props.spacing} defaultSpacing="md">
  <Stack space="xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <ul class:list={["s-logos", `s-logos--${variant}`, `s-logos--sm-${rows.sm}`, `s-logos--md-${rows.md}`, `s-logos--lg-${rows.lg}`]}>
      {content.items.map((item) => (
        <li class="s-logos__item">
          <Logo logo={item.logo} name={item.name} href={item.href} />
        </li>
      ))}
    </ul>
  </Stack>
</SectionShell>

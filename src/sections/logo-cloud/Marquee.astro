---
/**
 * An endless band of logos between thin rules (v3.3). One loop is the logos repeated until it is
 * wider than the band; the track holds the loop twice and slides by half its width, then starts
 * over. Only the first round is content — the repeats are aria-hidden images without links.
 * It moves only with JavaScript (the pause button needs it) and without reduced motion, and
 * pauses on hover, on focus and with the button; otherwise the logos stand in a wrapped row.
 * The band clips the track like a slider track (data-slider-track: the overflow check skips
 * what moves inside it).
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Logo from "@/sections/logo-cloud/Logo.astro";
import Stack from "@/components/layouts/Stack.astro";
import { marqueeRepeats } from "@/sections/logo-cloud/layout";
import { t } from "@/i18n";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"logo-cloud", "marquee">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const repeats = marqueeRepeats(content.items.length);
// The speed follows the loop's length (a class per length: inline styles are blocked by the CSP).
const loop = content.items.length * repeats;
const copies = Array.from({ length: repeats * 2 - 1 }, () => content.items).flat();
---

<SectionShell id={section.id} type="logo-cloud" variant="marquee" tone={props.tone} spacing={props.spacing} defaultSpacing="md">
  <Stack space="xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <div class="s-marquee" data-marquee>
      <div class="s-marquee__band" data-slider-track>
        <ul class:list={["s-marquee__track", `s-marquee__track--${loop}`]}>
          {content.items.map((item) => (
            <li class="s-marquee__item">
              <Logo logo={item.logo} name={item.name} href={item.href} />
            </li>
          ))}
          {copies.map((item) => (
            <li class="s-marquee__item s-marquee__item--copy" aria-hidden="true">
              <Logo logo={item.logo} name={item.name} decorative />
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class="s-marquee__toggle" data-marquee-toggle aria-pressed="false" aria-label={t.slider.pause}>
        <svg class="s-marquee__pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
        <svg class="s-marquee__play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M8.5 6.5v11l9-5.5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </Stack>
</SectionShell>

<script>
  // Pressed = paused; the band's CSS reads aria-pressed.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-marquee-toggle]")) {
    toggle.addEventListener("click", () => toggle.setAttribute("aria-pressed", String(toggle.getAttribute("aria-pressed") !== "true")));
  }
</script>

---
/**
 * Comparison table: plans as columns (price row, button row), the union of their features
 * as rows with a check or a dash. Phones: every feature becomes a line above its marks.
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Stack from "@/components/layouts/Stack.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/media/Icon.astro";
import { t } from "@/i18n";
import { featureRows } from "@/site/pricing";
import type { SectionOf } from "@/site/types";
import "@/styles/sections/pricing/_note.scss";
import "@/styles/sections/pricing/_table.scss";

export interface Props {
  section: SectionOf<"pricing">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const plans = content.plans;
const rows = featureRows(plans);
const planId = (index: number) => `${section.id}-plan-${plans[index].id}`;
const cell = (index: number) => ["s-plan-table__plan", plans[index].highlighted && "s-plan-table__plan--highlighted"];
---

<SectionShell id={section.id} type="pricing" variant="table" tone={props.tone} spacing={props.spacing}>
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <table class:list={["s-plan-table", `s-plan-table--count-${plans.length}`]}>
      <caption class="visually-hidden">{content.title}</caption>
      <colgroup>
        <col class="s-plan-table__label-column" />
        {plans.map(() => <col />)}
      </colgroup>
      <thead>
        <tr>
          <td class="s-plan-table__corner"></td>
          {plans.map((plan, index) => (
            <th scope="col" id={planId(index)} class:list={[...cell(index), "s-plan-table__head"]}>
              {plan.highlighted && <span class="s-plan-table__badge">{t.sections.popularPlan}</span>}
              <span class="s-plan-table__name">{plan.name}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <tr class="s-plan-table__prices">
          <th scope="row" class="s-plan-table__label">{t.sections.planPrice}</th>
          {plans.map((plan, index) => (
            <td class:list={cell(index)}>
              <span class="s-plan-table__amount">{plan.price}</span>
              {plan.period && <span class="s-plan-table__period">{plan.period}</span>}
              {plan.description && <span class="s-plan-table__description">{plan.description}</span>}
            </td>
          ))}
        </tr>
        {rows.map((row) => (
          <tr class="s-plan-table__feature">
            <th scope="row" class="s-plan-table__label">{row.feature}</th>
            {row.included.map((included, index) => (
              <td class:list={cell(index)}>
                {included ? <Icon name="check" size="1.25rem" class="s-plan-table__yes" /> : <span class="s-plan-table__no" aria-hidden="true"></span>}
                <span class="visually-hidden">{included ? t.sections.planIncluded : t.sections.planExcluded}</span>
              </td>
            ))}
          </tr>
        ))}
        {plans.some((plan) => plan.action) && (
          <tr class="s-plan-table__actions">
            <td class="s-plan-table__corner"></td>
            {plans.map((plan, index) => (
              <td class:list={cell(index)}>
                {plan.action && (
                  <Button href={plan.action.href} variant={plan.highlighted ? "primary" : "secondary"} size="sm" aria-describedby={planId(index)}>{plan.action.label}</Button>
                )}
              </td>
            ))}
          </tr>
        )}
      </tbody>
    </table>
    {content.note && <p class="s-plans__note">{content.note}</p>}
  </Stack>
</SectionShell>

---
/** Cards with a large round photo and the member's icon links sitting on its edge; 1–2 people get wide cards. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Avatar from "@/sections/team/Avatar.astro";
import MemberLinks from "@/sections/team/MemberLinks.astro";
import Stack from "@/components/layouts/Stack.astro";
import { teamColumns } from "@/sections/team/layout";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"team", "social-cards">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const count = content.members.length;
const NameHeading = headingLevel === "h1" ? "h2" : "h3";
---

<SectionShell id={section.id} type="team" variant="social-cards" tone={props.tone} spacing={props.spacing}>
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <ul class:list={["s-team-cols", `s-team-cols--${teamColumns(count)}`, "s-team-social", count <= 2 && "s-team-social--wide"]}>
      {content.members.map((member) => (
        <li class="s-team-social__item">
          <Avatar name={member.name} photo={member.photo} widths={[192, 320, 400]} sizes="12rem" decorative class="s-team-social__avatar" />
          <div class="s-team-social__text">
            <NameHeading class="s-team-social__name" id={`${section.id}-${member.id}-name`}>{member.name}</NameHeading>
            <p class="s-team-social__role">{member.role}</p>
            {member.bio && <p class="s-team-social__bio">{member.bio}</p>}
          </div>
          {/* After the text in reading order; the grid places the links on the photo's edge. */}
          {member.socials && member.socials.length > 0 && (
            <MemberLinks
              links={member.socials}
              describedBy={`${section.id}-${member.id}-name`}
              class={`s-team-social__links s-team-social__links--${member.socials.length}`}
            />
          )}
        </li>
      ))}
    </ul>
  </Stack>
</SectionShell>

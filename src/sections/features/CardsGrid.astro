---
import FeatureGrid from "@/components/widgets/FeatureGrid.astro";
import type { SectionOf } from "@/site/types";
import { toneFor } from "@/site/theme";

export interface Props {
  section: SectionOf<"features">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
---

<FeatureGrid
  id={section.id}
  headingLevel={headingLevel}
  eyebrow={content.eyebrow}
  title={content.title}
  description={content.description}
  items={content.items}
  columns={props.columns}
  tone={toneFor("features", props.tone)}
  align={props.align}
/>

---
/** Feature cards in columns (1 on phones); a short last row is centered. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import ItemLink from "@/sections/features/ItemLink.astro";
import Stack from "@/components/layouts/Stack.astro";
import Icon from "@/components/media/Icon.astro";
import Card from "@/components/ui/Card.astro";
import { autoColumns } from "@/sections/features/layout";
import { toneFor } from "@/site/theme";
import type { VariantOf } from "@/site/types";
import "@/styles/sections/features/_shared.scss";
import "@/styles/sections/features/_cards-grid.scss";

export interface Props {
  section: VariantOf<"features", "cards-grid">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const columns = props.columns ?? autoColumns(content.items.length);
const ItemHeading = headingLevel === "h1" ? "h2" : "h3";
---

<SectionShell id={section.id} type="features" variant="cards-grid" tone={props.tone ?? toneFor("features", undefined) ?? "muted"} spacing={props.spacing}>
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <ul class:list={["s-features-cols", `s-features-cols--${columns}`, "s-features-cards"]}>
      {content.items.map((item) => (
        <Card as="li" variant="elevated" padding="lg" class="s-features-cards__item">
          {item.icon && <span class="s-features-cards__icon" aria-hidden="true"><Icon name={item.icon} size="1.5rem" /></span>}
          {item.eyebrow && <p class="s-features-eyebrow">{item.eyebrow}</p>}
          <ItemHeading class="s-features-cards__title" id={`${section.id}-${item.id}-title`}>{item.title}</ItemHeading>
          <p class="s-features-cards__description">{item.description}</p>
          {item.link && <ItemLink link={item.link} describedBy={`${section.id}-${item.id}-title`} class="s-features-cards__link" />}
        </Card>
      ))}
    </ul>
  </Stack>
</SectionShell>

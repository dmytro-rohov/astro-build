---
/** Centered cards offset up and down in a zigzag over a colored band. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import ItemLink from "@/sections/features/ItemLink.astro";
import Stack from "@/components/layouts/Stack.astro";
import Icon from "@/components/media/Icon.astro";
import { autoColumns } from "@/sections/features/layout";
import type { VariantOf } from "@/site/types";
import "@/styles/sections/features/_shared.scss";
import "@/styles/sections/features/_staggered.scss";

export interface Props {
  section: VariantOf<"features", "staggered">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const ItemHeading = headingLevel === "h1" ? "h2" : "h3";
---

<SectionShell id={section.id} type="features" variant="staggered" tone={props.tone} spacing={props.spacing}>
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <ul class:list={["s-features-cols", `s-features-cols--${autoColumns(content.items.length)}`, "s-features-staggered"]}>
      {content.items.map((item, index) => (
        <li class="s-features-staggered__item">
          <span class="s-features-staggered__icon" aria-hidden="true">
            {item.icon ? <Icon name={item.icon} size="1.75rem" /> : String(index + 1).padStart(2, "0")}
          </span>
          {item.eyebrow && <p class="s-features-eyebrow">{item.eyebrow}</p>}
          <ItemHeading class="s-features-staggered__title" id={`${section.id}-${item.id}-title`}>{item.title}</ItemHeading>
          <p class="s-features-staggered__description">{item.description}</p>
          {item.link && <ItemLink link={item.link} describedBy={`${section.id}-${item.id}-title`} class="s-features-staggered__link" />}
        </li>
      ))}
    </ul>
  </Stack>
</SectionShell>

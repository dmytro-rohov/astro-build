---
/** A row of cards with one raised, larger card (the middle one or `highlight`). */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import ItemLink from "@/sections/features/ItemLink.astro";
import Stack from "@/components/layouts/Stack.astro";
import Icon from "@/components/media/Icon.astro";
import { autoColumns, highlightIndex } from "@/sections/features/layout";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"features", "spotlight">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const columns = autoColumns(content.items.length);
const active = highlightIndex(content.items.length, columns, props.highlight);
const ItemHeading = headingLevel === "h1" ? "h2" : "h3";
---

<SectionShell id={section.id} type="features" variant="spotlight" tone={props.tone} spacing={props.spacing}>
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <ul class:list={["s-features-cols", `s-features-cols--${columns}`, "s-features-spotlight", `s-features-spotlight--${props.align ?? "center"}`]}>
      {content.items.map((item, index) => (
        <li class:list={["s-features-spotlight__item", index === active && "s-features-spotlight__item--active"]}>
          <span class="s-features-spotlight__icon" aria-hidden="true">
            {item.icon ? <Icon name={item.icon} size="1.5rem" /> : String(index + 1).padStart(2, "0")}
          </span>
          {item.eyebrow && <p class="s-features-eyebrow">{item.eyebrow}</p>}
          <ItemHeading class="s-features-spotlight__title" id={`${section.id}-${item.id}-title`}>{item.title}</ItemHeading>
          <p class="s-features-spotlight__description">{item.description}</p>
          {item.link && <ItemLink link={item.link} describedBy={`${section.id}-${item.id}-title`} class="s-features-spotlight__link" />}
        </li>
      ))}
    </ul>
  </Stack>
</SectionShell>

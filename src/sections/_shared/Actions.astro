---
/** Primary button + optional secondary link, as used by many sections. */
import Cluster from "@/components/layouts/Cluster.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";

type Action = { label: string; href: string };

export interface Props {
  primary?: Action;
  secondary?: Action;
  align?: "left" | "center";
  size?: "md" | "lg";
}

const { primary, secondary, align = "left", size = "lg" } = Astro.props;
---

{(primary || secondary) && (
  <Cluster gap="md" justify={align === "center" ? "center" : "start"} class="s-actions">
    {primary && <Button href={primary.href} size={size}>{primary.label}</Button>}
    {secondary && <Link href={secondary.href}>{secondary.label}</Link>}
  </Cluster>
)}

---
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import RichText from "@/sections/_shared/RichText.astro";
import Actions from "@/sections/_shared/Actions.astro";
import Highlights from "@/sections/about/Highlights.astro";
import Stack from "@/components/layouts/Stack.astro";
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"about", "image-side">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const image = content.image ? getAsset(content.image) : undefined;
---

<SectionShell id={section.id} type="about" variant="image-side" tone={props.tone} spacing={props.spacing}>
  <div class:list={["s-about__layout", image && "s-about__layout--with-image", props.imagePosition === "left" && "s-about__layout--image-left"]}>
    <Stack space="lg" class="s-about__text">
      <SectionHeader eyebrow={content.eyebrow} title={content.title} headingLevel={headingLevel} />
      <RichText text={content.body} />
      {content.highlights && <Highlights items={content.highlights} />}
      <Actions primary={content.action} size="md" />
    </Stack>
    {image && (
      <div class="s-about__media">
        <Img src={image.image} alt={image.alt} kind={image.alt ? "content" : "decorative"} aspect={[4, 5]} focal={image.focal} sizes="(min-width: 768px) 40vw, 100vw" widths={[480, 720, 960]} class="image--rounded image--shadow s-about__image" />
      </div>
    )}
  </div>
</SectionShell>

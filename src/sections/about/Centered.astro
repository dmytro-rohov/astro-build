---
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import RichText from "@/sections/_shared/RichText.astro";
import Actions from "@/sections/_shared/Actions.astro";
import Highlights from "@/sections/about/Highlights.astro";
import Stack from "@/components/layouts/Stack.astro";
import type { SectionOf } from "@/site/types";

export interface Props {
  section: SectionOf<"about">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
---

<SectionShell id={section.id} type="about" variant="centered" tone={props.tone} spacing={props.spacing} width="md">
  <Stack space="lg" class="s-about-centered">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} headingLevel={headingLevel} align="center" />
    <RichText text={content.body} class="s-about-centered__body" />
    {content.highlights && <Highlights items={content.highlights} align="center" />}
    <Actions primary={content.action} align="center" size="md" />
  </Stack>
</SectionShell>

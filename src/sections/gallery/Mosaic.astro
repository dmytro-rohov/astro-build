---
/**
 * Square cells, no gaps left: the first photo 2 × 2, the rest 1 × 1, and wide or a second large
 * tile where the count needs them (layout.ts). Captions are labels on the photos.
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import MoreLink from "@/sections/gallery/MoreLink.astro";
import Photo from "@/sections/gallery/Photo.astro";
import Stack from "@/components/layouts/Stack.astro";
import Lightbox from "@/components/widgets/Lightbox.astro";
import { mosaicTiles, tileSizes } from "@/sections/gallery/layout";
import { format, t } from "@/i18n";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"gallery", "mosaic">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const count = content.items.length;
const tiles = mosaicTiles(count);
const lightbox = props.lightbox ?? true;
const align = props.align ?? "left";
---

<SectionShell id={section.id} type="gallery" variant="mosaic" tone={props.tone} spacing={props.spacing} width="xl">
  <Stack space="xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={align} />
    <div class="s-mosaic">
      <Lightbox label={content.title} enabled={lightbox}>
        <ul class="s-mosaic__list">
          {content.items.map((item, index) => {
            const tile = tiles[index];
            return (
              <li class:list={["s-mosaic__tile", tile && `s-mosaic__tile--${tile}`]}>
                <figure class="s-mosaic__figure">
                  <Photo
                    image={item.image}
                    caption={item.caption}
                    lightbox={lightbox}
                    aspect={tile === "wide" ? [2, 1] : [1, 1]}
                    widths={tile ? [480, 800, 1200] : [320, 480, 640]}
                    sizes={tile ? tileSizes(2, 1) : tileSizes(4, 2)}
                    label={format(t.lightbox.status, { number: index + 1, count })}
                  />
                  {item.caption && <figcaption class="s-gallery__label">{item.caption}</figcaption>}
                </figure>
              </li>
            );
          })}
        </ul>
      </Lightbox>
    </div>
    <MoreLink link={content.link} align={align} />
  </Stack>
</SectionShell>

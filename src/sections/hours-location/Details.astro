---
/**
 * Hours table and address block shared by the card and image-side variants: a heading with an
 * icon badge, then the grouped hours ("Pn–Pt 9:00–18:00") or the address with the phone, the
 * route planner and the map link. Without an address the block shows the phone alone.
 */
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Icon from "@/components/media/Icon.astro";
import { site } from "virtual:site";
import { t } from "@/i18n";
import { addressLines, directionsUrl, hoursRows } from "@/site/hours";

export interface Props {
  part: "hours" | "address";
  mapUrl?: string;
  showPhone: boolean;
  headingLevel: "h2" | "h3";
}

const { part, mapUrl, showPhone, headingLevel } = Astro.props;
const { business } = site;
const Heading = headingLevel;
const rows = hoursRows(business.hours, t);
const lines = addressLines(business.address);
const directions = directionsUrl(business.address);
const phone = showPhone ? business.phone : undefined;
---

{part === "hours" && rows.length > 0 && (
  <div class="s-hours">
    <div class="s-hours__head">
      <span class="s-hours__badge"><Icon name="clock" size="1.25rem" /></span>
      <Heading class="s-hours__title">{t.sections.hoursTitle}</Heading>
    </div>
    <table class="s-hours__table">
      <tbody>
        {rows.map((row) => (
          <tr class:list={["s-hours__row", row.closed && "s-hours__row--closed"]}>
            <th scope="row"><abbr title={row.daysLong}>{row.days}</abbr></th>
            <td>{row.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{part === "address" && (lines.length > 0 || phone) && (
  <div class="s-location">
    <div class="s-hours__head">
      <span class="s-hours__badge"><Icon name={lines.length ? "map-pin" : "phone"} size="1.25rem" /></span>
      <Heading class="s-hours__title">{lines.length ? t.sections.address : t.sections.phone}</Heading>
    </div>
    {lines.length > 0 && (
      <address class="s-location__address">
        {lines.map((line) => <span>{line}</span>)}
      </address>
    )}
    {phone && (
      <p class="s-location__phone">
        {lines.length > 0 && <Icon name="phone" size="1.125rem" class="s-location__icon" />}
        <span class="visually-hidden">{t.sections.phone}: </span>
        <Link href={`tel:${phone.replace(/[^\d+]/g, "")}`}>{phone}</Link>
      </p>
    )}
    {(directions || mapUrl) && (
      <div class="s-location__actions">
        {directions && <Button href={directions} variant="primary" size="sm"><Icon name="navigation" size="1rem" />{t.sections.directions}</Button>}
        {mapUrl && <Button href={mapUrl} variant="secondary" size="sm">{t.sections.openInMaps}</Button>}
      </div>
    )}
  </div>
)}

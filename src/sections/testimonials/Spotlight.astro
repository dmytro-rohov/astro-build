---
/** The first three quotes, large and stacked like a magazine page; the quote mark hangs in the margin. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Avatar from "@/sections/testimonials/Avatar.astro";
import QuoteMark from "@/sections/testimonials/QuoteMark.astro";
import Stars from "@/sections/testimonials/Stars.astro";
import Stack from "@/components/layouts/Stack.astro";
import { quoteSize } from "@/sections/testimonials/layout";
import { SPOTLIGHT_ITEMS } from "@/sections/testimonials/schema";
import type { SectionOf } from "@/site/types";
import "@/styles/sections/testimonials/_shared.scss";
import "@/styles/sections/testimonials/_spotlight.scss";

export interface Props {
  section: SectionOf<"testimonials">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const items = content.items.slice(0, SPOTLIGHT_ITEMS);
const size = quoteSize(...items.map((item) => item.quote));
---

<SectionShell id={section.id} type="testimonials" variant="spotlight" tone={props.tone} spacing={props.spacing} width="md">
  <Stack space="2xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} headingLevel={headingLevel} align="center" />
    <div class="s-spotlight-list">
      {items.map((item) => (
        <figure class="s-spotlight">
          <QuoteMark class="s-spotlight__mark" />
          {item.rating && <Stars rating={item.rating} class="s-spotlight__stars" />}
          <blockquote class:list={["s-spotlight__quote", `s-spotlight__quote--${size}`]}><p>{item.quote}</p></blockquote>
          <figcaption class="s-spotlight__author">
            <Avatar author={item.author} avatar={item.avatar} size="3.5rem" widths={[112, 160]} />
            <span>
              <span class="s-testimonial__name">{item.author}</span>
              {item.role && <span class="s-testimonial__role">{item.role}</span>}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Stack>
</SectionShell>

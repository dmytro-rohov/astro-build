---
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Stars from "@/sections/testimonials/Stars.astro";
import Stack from "@/components/layouts/Stack.astro";
import Grid from "@/components/layouts/Grid.astro";
import Card from "@/components/ui/Card.astro";
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import type { SectionOf } from "@/site/types";

export interface Props {
  section: SectionOf<"testimonials">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
---

<SectionShell id={section.id} type="testimonials" variant="cards" tone={props.tone} spacing={props.spacing}>
  <Stack space="xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align={props.align ?? "center"} />
    <Grid as="ul" columns="3" gap="lg" class="s-testimonials__list">
      {content.items.map((item) => {
        const avatar = item.avatar ? getAsset(item.avatar) : undefined;
        return (
          <Card as="li" variant="elevated" class="s-testimonials__card">
            <figure class="s-testimonial">
              {item.rating && <Stars rating={item.rating} />}
              <blockquote class="s-testimonial__quote"><p>{item.quote}</p></blockquote>
              <figcaption class="s-testimonial__author">
                {avatar && <Img src={avatar.image} alt="" kind="decorative" aspect={[1, 1]} focal={avatar.focal} widths={[96, 160]} sizes="48px" class="s-testimonial__avatar" />}
                <span>
                  <span class="s-testimonial__name">{item.author}</span>
                  {item.role && <span class="s-testimonial__role">{item.role}</span>}
                </span>
              </figcaption>
            </figure>
          </Card>
        );
      })}
    </Grid>
  </Stack>
</SectionShell>

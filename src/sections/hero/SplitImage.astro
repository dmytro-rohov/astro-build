---
/** Text on the left, image on the right (single column on phones / without an image). */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import Split from "@/components/layouts/Split.astro";
import Stack from "@/components/layouts/Stack.astro";
import Cluster from "@/components/layouts/Cluster.astro";
import Tag from "@/components/ui/Tag.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import type { SectionOf } from "@/site/types";

export interface Props {
  section: SectionOf<"hero">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const image = content.image ? getAsset(content.image) : undefined;
const align = props.align ?? "left";
const Heading = headingLevel;
const hasActions = Boolean(content.primaryAction || content.secondaryAction);

// With an image the content sits next to the media; without one it is a single column.
const Layout = image ? Split : Stack;
const layoutProps = image ? ({ ratio: "text-media", gap: "2xl", align: "center" } as const) : ({ space: "lg" } as const);
---

<SectionShell
  id={section.id}
  type="hero"
  variant="split-image"
  tone={props.tone}
  spacing={props.spacing}
  defaultSpacing="xl"
  width="xl"
  class:list={["hero", `hero--align-${align}`, image && "hero--with-media"]}
>
  <Layout {...layoutProps}>
    <Stack class="hero__content" space="lg">
      {content.eyebrow && <Tag variant="primary" class="hero__eyebrow">{content.eyebrow}</Tag>}

      <Stack space="md">
        <Heading class="hero__title">{content.title}</Heading>
        {content.description && <p class="hero__description">{content.description}</p>}
      </Stack>

      {hasActions && (
        <Cluster class="hero__actions" gap="md">
          {content.primaryAction && <Button href={content.primaryAction.href} size="lg">{content.primaryAction.label}</Button>}
          {content.secondaryAction && <Link href={content.secondaryAction.href}>{content.secondaryAction.label}</Link>}
        </Cluster>
      )}
    </Stack>

    {image && (
      <div class="hero__media">
        <Img
          src={image.image}
          alt={image.alt}
          kind={image.alt ? "content" : "decorative"}
          priority={headingLevel === "h1" ? "high" : "auto"}
          sizes="(min-width: 768px) 50vw, 100vw"
          widths={[480, 720, 960]}
          aspect={[4, 3]}
          focal={image.focal}
          class="hero__image image--rounded image--shadow"
        />
      </div>
    )}
  </Layout>
</SectionShell>

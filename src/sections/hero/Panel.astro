---
/**
 * Edge-to-edge split: the text sits on a panel in the section tone, the photo
 * fills the other half up to the screen edge (photo on top on phones).
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Actions from "@/sections/_shared/Actions.astro";
import Highlights from "@/sections/about/Highlights.astro";
import Stack from "@/components/layouts/Stack.astro";
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"hero", "panel">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const image = content.image ? getAsset(content.image) : undefined;
const position = props.imagePosition ?? "right";
---

<SectionShell id={section.id} type="hero" variant="panel" tone={props.tone} spacing={props.spacing} width="full" class:list={[`s-hero-panel--image-${position}`, !image && "s-hero-panel--no-image"]}>
  <div class="s-hero-panel">
    <div class="s-hero-panel__text">
      <Stack space="xl" class="s-hero-panel__content">
        <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align="left" class="s-hero__header" />
        <Actions primary={content.primaryAction} secondary={content.secondaryAction} />
        {content.highlights && <Highlights items={content.highlights} />}
      </Stack>
    </div>
    {image && (
      <div class="s-hero-panel__media">
        <Img
          src={image.image}
          alt={image.alt}
          kind={image.alt ? "content" : "decorative"}
          aspect={[4, 3]}
          focal={image.focal}
          priority={headingLevel === "h1" ? "high" : "auto"}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="s-hero-panel__image"
        />
      </div>
    )}
  </div>
</SectionShell>

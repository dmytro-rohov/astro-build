---
/**
 * Centered headline, text and buttons above a photo band that reaches the screen edges and the
 * next section; the band takes the rest of the first screen. Without an image: centered text.
 */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import Actions from "@/sections/_shared/Actions.astro";
import Stack from "@/components/layouts/Stack.astro";
import Img from "@/components/media/Img.astro";
import { getAsset } from "@/site/assets";
import type { VariantOf } from "@/site/types";
import "@/styles/sections/hero/_band.scss";

export interface Props {
  section: VariantOf<"hero", "band">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const image = content.image ? getAsset(content.image) : undefined;
---

<SectionShell
  id={section.id}
  type="hero"
  variant="band"
  tone={props.tone}
  spacing={props.spacing}
  defaultSpacing="lg"
  width="full"
  class:list={[image && "s-hero-band--with-image"]}
>
  <div class="s-hero-band">
    <Stack space="xl" class="s-hero-band__content">
      <SectionHeader eyebrow={content.eyebrow} title={content.title} description={content.description} headingLevel={headingLevel} align="center" class="s-hero-band__header" />
      <Actions primary={content.primaryAction} secondary={content.secondaryAction} align="center" />
    </Stack>
    {image && (
      <div class="s-hero-band__media">
        <Img
          src={image.image}
          alt={image.alt}
          kind={image.alt ? "content" : "decorative"}
          aspect={[4, 3]}
          focal={image.focal}
          priority={headingLevel === "h1" ? "high" : "auto"}
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          class="s-hero-band__image"
        />
      </div>
    )}
  </div>
</SectionShell>

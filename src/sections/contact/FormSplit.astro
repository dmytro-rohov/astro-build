---
/** Heading and the contact details (icon rows, stay in view) on the left, the form in a card on the right. */
import SectionShell from "@/sections/_shared/SectionShell.astro";
import SectionHeader from "@/sections/_shared/SectionHeader.astro";
import DetailList from "@/sections/contact/DetailList.astro";
import Form from "@/sections/contact/Form.astro";
import { site } from "virtual:site";
import { t } from "@/i18n";
import { contactDetails, contactHeader } from "@/sections/contact/details";
import type { VariantOf } from "@/site/types";

export interface Props {
  section: VariantOf<"contact", "form-split">;
  headingLevel: "h1" | "h2";
}

const { section, headingLevel } = Astro.props;
const { content, props } = section;
const details = content.showDetails ? contactDetails(site.business, t) : [];
const SubHeading = headingLevel === "h1" ? "h2" : "h3";
---

<SectionShell id={section.id} type="contact" variant="form-split" tone={props.tone} spacing={props.spacing}>
  <div class="s-contact-split">
    <div class="s-contact-split__aside">
      <SectionHeader {...contactHeader(content, t)} headingLevel={headingLevel} align={props.align ?? "left"} />
      {details.length > 0 && (
        <div class="s-contact-split__details">
          <SubHeading class="s-contact-split__details-title">{t.contactForm.detailsTitle}</SubHeading>
          <DetailList details={details} />
        </div>
      )}
    </div>
    <div class="s-contact-split__form">
      <Form />
    </div>
  </div>
</SectionShell>

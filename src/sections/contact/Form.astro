---
/**
 * ContactForm wired to the site: its fields and button (contact.form), and where it posts: this site's /api/contact
 * (local) or the form service (remote). Nothing when the site has no form (contact.form.enabled false): the contact
 * variants then show the details only.
 */
import ContactForm from "@/components/form/ContactForm.astro";
import { fieldsOf } from "@/lib/contact/fields";
import { site } from "virtual:site";

export interface Props {
  class?: string;
}

const remote = site.contact.mode === "remote" ? site.contact : undefined;
const form = site.contact.form;
---

{form?.enabled !== false && (
  <ContactForm
    action={remote ? remote.endpoint : "/api/contact"}
    hiddenFields={remote ? { siteId: site.siteId, lang: site.lang } : {}}
    method="post"
    privacyHref="/privacy"
    fields={fieldsOf(form)}
    submitLabel={form?.submitLabel}
    class={Astro.props.class}
  />
)}

{
  "name": "astro-starter",
  "type": "module",
  "version": "3.0.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "dev": "astro dev",
    "start": "node server.mjs",
    "tokens": "tsx src/design-system/utils/cssVars.ts",
    "build-icons": "node scripts/build-icons.js",
    "build:fonts": "node scripts/build-fonts.js",
    "build:system": "npm run tokens && npm run build-icons && npm run build:fonts && npm run build:app-icons",
    "build": "npm run build:system && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:scss && npm run lint:js",
    "validate": "npm run lint && npm run test:unit && npm run check && npm run build",
    "build:app-icons": "node scripts/build-app-icons.js",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "test": "npm run test:e2e && npm run test:lighthouse",
    "ci": "npm run validate && npm run test:broken-site && npm run test",
    "test:docker": "bash scripts/docker-smoke.sh",
    "test:unit": "vitest run",
    "site:validate": "tsx scripts/site/validate.ts",
    "site:build": "tsx scripts/site/build.ts",
    "test:broken-site": "bash scripts/site/check-broken.sh"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "resend": "^6.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "1.64.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "fontkit": "^2.0.4",
    "fs-extra": "^11.3.3",
    "globals": "^17.9.0",
    "sass": "^1.97.3",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "subset-font": "^2.9.0",
    "svgo": "^4.0.0",
    "svgstore": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.1.0"
  }
}
